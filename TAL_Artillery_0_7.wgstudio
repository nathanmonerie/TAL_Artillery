      "expr": "8"
    },
    {
      "id": "1048d299-f052-4cee-921b-8960a4b11ba4",
      "name": "NBWORKX",
      "expr": "SIZEX/SIZEWORKX"
    },
    {
      "id": "2468934e-6efd-457e-93f5-57c37cea6acf",
      "name": "NBWORKY",
      "expr": "SIZEY/SIZEWORKY"
    },
    {
      "id": "b42ddf0e-e83c-40e2-a5bc-6b17806f642c",
