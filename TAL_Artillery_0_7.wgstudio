  "shaders": [
    {
      "id": "4b21c4f4-130f-4927-8494-5e3fd1e4df9c",
      "name": "Init",
      "workgroup": {
        "x": 8,
        "y": 8,
        "z": 1
      },
      "code": "@compute @workgroup_size(SIZEWORKX, SIZEWORKY, 1)\nfn Init(@builtin(global_invocation_id) gid : vec3<u32>) {\n\t\tif (step == 0){\n\t\t\t\tterrainInit();\n\t\t\t\tterrainFill(gid);\n\t\t\t\tcurveInit();\n\t\t}\n}\n\nfn curveInit() {\n\t\t// origine x, origine y, angle, velocité, r, g, b, temps de départ, état (à -1 de base, non réglable),  \n\t\t// collision x ( à -1 de base, non réglable), collision y ( à -1 de base, non réglable), step de l'explosion ( à -1 de base, non réglable)\n\t\tvar y : i32 = 0;\n\n\t\tif (GAMETYPE==0){\n\t\t\t\t// A IMPLEMENTER : VRAI JEU\n\t\t}else{\n\t\t\t\tfor (var i : i32 = 0; i < NBCURVE; i++){\n\t\t\t\t\t\tCurveData[CDAccess(0,y)] = SIZEX/2;\n\t\t\t\t\t\tCurveData[CDAccess(1,y)] = SIZEY/2;\n\t\t\t\t\t\tCurveData[CDAccess(2,y)] = radians(f32(i*(360/NBCURVE)));\n\t\t\t\t\t\tCurveData[CDAccess(3,y)] = 55;\n\n\t\t\t\t\t\tCurveData[CDAccess(4,y)] = 0.9;\n\t\t\t\t\t\tCurveData[CDAccess(5,y)] = 0.9;\n\t\t\t\t\t\tCurveData[CDAccess(6,y)] = 0.9;\n\n\t\t\t\t\t\tCurveData[CDAccess(7,y)] = f32(i);\n\t\t\t\t\t\tCurveData[CDAccess(8,y)] = -1;\n\n\t\t\t\t\t\tCurveData[CDAccess(9,y)] = -1;\n\t\t\t\t\t\tCurveData[CDAccess(10,y)] = -1;\n\t\t\t\t\t\tCurveData[CDAccess(11,y)] = -1;\n\t\t\t\t\t\ty++;\n\t\t\t\t}\n\t\t}\n}\n\nfn terrainInit() {\n\t\tfor (var i : i32 = 0; i < NBTERRAINPOINT; i++){\n\t\t\t\tTerrainData[TDAccess(0,i)] = ((SIZEX/(NBTERRAINPOINT-1))*i);\n\t\t\t\tTerrainData[TDAccess(1,i)] =\ti32( alea(u32(i), u32(NBTERRAINPOINT - i),Random[0] )%(SIZEY) )/2;\n\t\t}\n}\n\nfn terrainFill(gid : vec3<u32>) {\n\t\tvar terrainSeg : i32 = i32(floor( f32(i32(gid.x-1)/( SIZEX/(NBTERRAINPOINT-1) )) ));\n\t\tvar x1 = TerrainData[TDAccess(0,terrainSeg)];\n\t\tvar x2 = TerrainData[TDAccess(0,terrainSeg+1)];\n\t\tvar y1 =  TerrainData[TDAccess(1,terrainSeg)];\n\t\tvar y2 =  TerrainData[TDAccess(1,terrainSeg+1)];\n\n\t\tvar xp = crossProduct(x1, x2, i32(gid.x), y1, y2 ,i32(gid.y));\n\t\t\n\t\tTerrainMatrix[TMAccess(i32(gid.x),i32(gid.y))] = i32(xp < 1);\n}",
      "bufferIds": [
        "tex-default",
        "0ce96281-8c6f-4830-bd4e-937144a403c2",
        "acab4bac-da45-4303-88be-f23b8db35de3",
        "d4138b69-1b0f-45cd-884b-f0d79be199a9",
        "5abcbbd6-9df6-4fe4-ab14-a51f994e8dd6"
      ]
    },
    {
      "id": "efcd35c5-52fe-4ffa-af63-6cde3893f240",
      "name": "DisplayFunc",
      "workgroup": {
        "x": 8,
        "y": 8,
        "z": 1
      },
      "code": "@compute @workgroup_size(SIZEWORKX, SIZEWORKY, 1)\nfn DisplayFunc(@builtin(global_invocation_id) gid : vec3<u32>) {\n\t\tterrainPhysic(gid);\n\t\tterrainDisplay(gid);\n\t\texplosionDisplay(gid);\n\t\tcurveDisplay(gid);\n}\n\nfn curveDisplay(gid : vec3<u32>) {\n\t\tfor (var i :i32 = 0; i < NBCURVE; i++){\n\t\t\t\tvar x0 : i32 = i32(CurveData[CDAccess(0,i)]);\n\t\t\t\tvar y0 : i32 = i32(CurveData[CDAccess(1,i)]);\n\t\t\t\tvar angle : f32 = CurveData[CDAccess(2,i)];\n\t\t\t\tvar velocity : u32 = u32(CurveData[CDAccess(3,i)]);\n\n\t\t\t\tvar r : f32 = CurveData[CDAccess(4,i)];\n\t\t\t\tvar g : f32 = CurveData[CDAccess(5,i)];\n\t\t\t\tvar b : f32 = CurveData[CDAccess(6,i)];\n\t\t\t\tvar col : vec3<f32> = vec3(r,g,b);\n\t\t\n\t\t\t\tvar start : u32 = u32(CurveData[CDAccess(7,i)]);\n\n\t\t\t\tvar collisionsCoord : vec2<i32>;\n\n\t\t\t\tlet curX = nextX(x0, velocity, angle, step - start);\n\t\t\t\tlet curY = nextY(y0, velocity, angle, step - start );\n\t\t\t\t\n\t\t\t\tif (step > start && CurveData[CDAccess(8,i)] == -1){\n\t\t\t\t\t\tCurveData[CDAccess(8,i)] = 0;\n\t\t\t\t}\n\t\t\t\tif (step > 0 && CurveData[CDAccess(8,i)] == 0){\n\t\t\t\t\t\tlet prevX1 = nextX(x0, velocity, angle,(step - start) - 1);\n\t\t\t\t\t\tlet prevY1 = nextY(y0, velocity, angle,(step - start) - 1);\n\t\t\t\t\t\tcollisionsCoord = curve(gid, prevX1, curX, prevY1, curY, col);\n\n\t\t\t\t\t\tif (step > 1 && CurveData[CDAccess(8,i)] == 0){\n\t\t\t\t\t\t\t\tlet col2 = vec3(col.x/2, col.y/2, col.z/2);\n\n\t\t\t\t\t\t\t\tlet prevX2 = nextX(x0, velocity, angle,(step - start) - 2);\n\t\t\t\t\t\t\t\tlet prevY2 = nextY(y0, velocity, angle,(step - start) - 2);\n\t\t\t\t\t\t\t\tcurve(gid, prevX2, prevX1, prevY2, prevY1, col2);\n\t\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\t\n\t\t\t\tif (collisionsCoord.x != -1 && collisionsCoord.y != -1 && CurveData[CDAccess(8,i)] == 0){\n\t\t\t\t\t\tCurveData[CDAccess(8,i)] = 1;\n\t\t\t\t\t\tCurveData[CDAccess(9,i)] = f32(collisionsCoord.x);\n\t\t\t\t\t\tCurveData[CDAccess(10,i)] = f32(collisionsCoord.y);\n\t\t\t\t\t\tCurveData[CDAccess(11,i)] = f32(step);\n\t\t\t\t}\n\t\t}\n}\n\nfn explosionDisplay(gid : vec3<u32>) {\n\t\tfor (var i :i32 = 0; i < NBCURVE; i++){\n\t\t\t\tif (CurveData[CDAccess(8,i)] == 1){\n\t\t\t\t\t\tlet x = CurveData[CDAccess(9,i)];\n\t\t\t\t\t\tlet y = CurveData[CDAccess(10,i)];\n\t\t\t\t\t\tlet curStep = f32(step) - CurveData[CDAccess(11,i)];\n\t\n\t\t\t\t\t\tlet r : f32 = CurveData[CDAccess(4,i)];\n\t\t\t\t\t\tlet g : f32 = CurveData[CDAccess(5,i)];\n\t\t\t\t\t\tlet b : f32 = CurveData[CDAccess(6,i)];\n\t\t\t\t\t\tlet col : vec3<f32> = vec3(r,g,b);\n\n\t\t\t\t\t\tlet xd = f32(gid.x) - x;\n\t\t\t\t\t\tlet yd = f32(gid.y) - y;\n\t\t\t\t\t\tlet d = sqrt(xd*xd + yd*yd);\n\n\t\t\t\t\t\tif (curStep  > 0 && curStep < NBFADEFRAME+1){\n\t\t\t\t\t\t\t\tif (d < f32(EXPLOSIONSIZE)){\t\n\t\t\t\t\t\t\t\t\t\tDisplay[gid.y * SIZEX + gid.x] = col; \n\t\t\t\t\t\t\t\t\t\tTerrainMatrix[TMAccess(i32(gid.x), i32(gid.y))] = 0;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t\tif (curStep > 0 && curStep < NBFADEFRAME+1){\n\t\t\t\t\t\t\t\tif( d < f32((EXPLOSIONSIZE/NBFADEFRAME)*curStep) ){ Display[gid.y * SIZEX + gid.x] = vec3(0.0, 0.0, 0.0); }\n\t\t\t\t\t\t}\n\t\t\t\t}\n\t\t}\n}\n\nfn terrainDisplay(gid : vec3<u32>) {\n\t\tif (TerrainMatrix[TMAccess(i32(gid.x),i32(gid.y))] == 1){ Display[gid.y * SIZEX + gid.x] = vec3(0.0, 0.5, 0.0); }\n\t\telse{ Display[gid.y * SIZEX + gid.x] = vec3(0.0, 0.0, 0.0); }\n}\n\nfn terrainPhysic(gid : vec3<u32>) {\n\t\tlet x = i32(gid.x);\n\t\tlet y = i32(gid.y);\n\t\tif (y > 0){\n\t\t\t\tif (TerrainMatrix[TMAccess(x,y)] == 1 && TerrainMatrix[TMAccess(x,y-1)] == 0){\n\t\t\t\t\t\t TerrainMatrix[TMAccess(x,y)] = 0;\n\t\t\t\t\t\t TerrainMatrix[TMAccess(x,y-1)] = 1;\n\t\t\t  }\n\t\t}\n}",
      "bufferIds": [
        "tex-default",
        "0ce96281-8c6f-4830-bd4e-937144a403c2",
        "acab4bac-da45-4303-88be-f23b8db35de3",
        "5abcbbd6-9df6-4fe4-ab14-a51f994e8dd6",
        "dbc28fe0-edba-491d-abfe-fe5fb2f32c2f"
      ]
    }
  ],
  "functions": [
    {
      "id": "6410ae56-c9f1-4117-b3aa-c376ffc0479b",
      "name": "Bibliothèque 1",
      "code": "fn nextX(x0: i32, v0 : u32, angle : f32, t : u32) -> i32 {\n\t\treturn x0 + i32(f32(v0*t)*cos(angle));\n}\n\nfn nextY(y0 : i32, v0 : u32, angle : f32, t : u32) -> i32 {\n\treturn y0 + i32(f32(v0*t)*sin(angle) - 0.5*g*f32(t*t));\n}\n\nfn line(x0 : i32, x1 : i32, y0 : i32, y1 : i32, col : vec3<f32>){\n    let dx = abs(x1 - x0);\n    let dy = abs(y1 - y0);\n    var sx = 0;\n    var sy = 0;\n    if (x0 < x1){ sx = 1; } else { sx = -1; }\n    if (y0 < y1){ sy = 1; } else { sy = -1; }\n    var err = dx - dy;\n    var x = x0;\n    var y = y0;\n    while (x != x1 && y != y1) {\n    \t\tDisplay[y*SIZEX + x] = col;\n       \tvar e2 = 2 * err;\n        if (e2 > -dy) {\n           \terr -= dy;\n           \tx += sx;\n        }\n       \tif (e2 < dx) {\n            err += dx;\n          \ty += sy;\n        }\n    }\n}\n\nfn curve(gid : vec3<u32>, x0 : i32, x1 : i32, y0 : i32, y1 : i32, col : vec3<f32>) -> vec2<i32>{\n    let dx = abs(x1 - x0);\n    let dy = abs(y1 - y0);\n    var sx = 0;\n    var sy = 0;\n    if (x0 < x1){ sx = 1; } else { sx = -1; }\n    if (y0 < y1){ sy = 1; } else { sy = -1; }\n    var err = dx - dy;\n    var x = x0;\n    var y = y0;\n    while (x != x1 && y != y1) {\n\t\t\t\tif (x > 0 && x < (SIZEX-1) && y >= 0 && TerrainMatrix[TMAccess(x,y)] == 0){\n\t\t\t\t\t\tif ( y < (SIZEY)) { Display[y*SIZEX + x] = col; } ;\n       \t\t  var e2 = 2 * err;\n        \t\tif (e2 > -dy) {\n           \t\t err -= dy;\n           \t\t x += sx;\n        \t\t}\n       \t\t if (e2 < dx) {\n            \t\terr += dx;\n            \t\ty += sy;\n         \t\t}\n\t\t\t\t}else{\n\t\t\t\t\t\tDisplay[y*SIZEX + x] = col;\n\t\t\t\t\t\treturn vec2(x, y);\n\t\t\t\t}\n     }\n\t\treturn vec2(-1,-1);\n}\n\nfn crossProduct(x1 : i32, x2 : i32, x3 : i32, y1 : i32, y2 : i32, y3 : i32) -> i32 {\n\t\tvar v1 : vec2<i32>;\n\t\tv1[0] = x1 - x2;\n\t\tv1[1] = y1 - y2;\n\t\tvar v2 : vec2<i32>;\n\t\tv2[0] = x2 - x3;\n\t\tv2[1] = y2 - y3;\n\n\t\treturn  (v1[0]*v2[1]) - (v1[1]*v2[0]);\n}\n\nfn CDAccess(x : i32, y : i32) -> i32 {\n\t\treturn y*NBPARAMCURVE + x;\n}\n\nfn TDAccess(x : i32, y : i32) -> i32 {\n\t\treturn y*2 + x;\n}\n\nfn TMAccess(x : i32, y : i32) -> i32 {\n\t\treturn y*SIZEX + x;\n}\n\nfn alea(x: u32, y: u32, step: u32) -> u32 {\n        var h: u32 = x;\n        h = h * 374761393u + y * 668265263u + step * 362437u;\n        h = (h ^(h >> 13u)) * 1274126177u;\n        h = h ^(h >> 16u);\n        return h;\n}"
    }
  ],
  "parameters": [
    {
      "id": "d1d79071-d1e5-4fe0-b892-8bd41fcc5417",
      "name": "GAMETYPE",
      "expr": "1"
    },
    {
      "id": "0a568031-495b-4fda-831c-8fd9ff54e55a",
