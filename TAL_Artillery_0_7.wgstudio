    },
    {
      "id": "e9950098-1ec2-4119-b4da-a7bdf06656db",
      "name": "NBTERRAINPOINT",
      "expr": "8"
    },
    {
      "id": "9439c7a6-4c9e-4dca-a3b0-35e4a3b3e769",
      "name": "EXPLOSIONSIZE",
      "expr": "10"
    },
    {
      "id": "af8e5751-a936-4964-b677-a07a29618399",
