  "shaders": [
    {
      "id": "4b21c4f4-130f-4927-8494-5e3fd1e4df9c",
      "name": "Init",
      "workgroup": {
        "x": 8,
        "y": 8,
        "z": 1
      },
      "code": "@compute @workgroup_size(8, 8, 1)\nfn Init(@builtin(global_invocation_id) gid : vec3<u32>) {\n\t\t// origine x, origine y, angle, velocité, couleur\n\t\tvar y : i32 = 0;\n/*\n\t\tCurveData[CDAccess(0,y)] = 0;\n\t\tCurveData[CDAccess(1,y)] = 0;\n\t\tCurveData[CDAccess(2,y)] = radians(45);\n\t\tCurveData[CDAccess(3,y)] = 50;\n\t\tCurveData[CDAccess(4,y)] = 0xff0000;\n\t\ty++;\n\n\t\tCurveData[CDAccess(0,1)] = 0;\n\t\tCurveData[CDAccess(1,1)] = 0;\n\t\tCurveData[CDAccess(2,1)] = radians(30);\n\t\tCurveData[CDAccess(3,1)] = 60;\n\t\tCurveData[CDAccess(4,1)] = 0x00ff00;\n\t\ty++;\n\n\t\tCurveData[CDAccess(0,y)] = 0;\n\t\tCurveData[CDAccess(1,y)] = 0;\n\t\tCurveData[CDAccess(2,y)] = radians(60);\n\t\tCurveData[CDAccess(3,y)] = 70;\n\t\tCurveData[CDAccess(4,y)] = 0x0000ff;\n\t\ty++;\n*/\n\t\tfor (var i : i32 = 0; i < NBCURVE; i++){\n\t\tCurveData[CDAccess(0,y)] = SIZEX/2;\n\t\tCurveData[CDAccess(1,y)] = SIZEY/2;\n\t\tCurveData[CDAccess(2,y)] = radians(f32(i*(360/NBCURVE)));\n\t\tCurveData[CDAccess(3,y)] = 50;\n\t\tCurveData[CDAccess(4,y)] = 0xffffff;\n\t\ty++;\n\t\t}\n}",
      "bufferIds": [
        "tex-default",
        "0ce96281-8c6f-4830-bd4e-937144a403c2"
      ]
    },
    {
      "id": "efcd35c5-52fe-4ffa-af63-6cde3893f240",
      "name": "Curve",
      "workgroup": {
        "x": 8,
        "y": 8,
        "z": 1
      },
      "code": "@compute @workgroup_size(SIZEWORKX, SIZEWORKY, 1)\nfn Curve(@builtin(global_invocation_id) gid : vec3<u32>) {\n\t\tfor (var i :i32 = 0; i < NBCURVE; i++){\n\t\t\t\tvar x0 : i32 = i32(CurveData[CDAccess(0,i)]);\n\t\t\t\tvar y0 : i32 = i32(CurveData[CDAccess(1,i)]);\n\t\t\t\tvar angle : f32 = CurveData[CDAccess(2,i)];\n\t\t\t\tvar velocity : u32 = u32(CurveData[CDAccess(3,i)]);\n\t\t\t\tvar color : i32 = i32(CurveData[CDAccess(4,i)]);\n\n\t\t\t\tvar isComplete : bool = false;\n\n\t\t\t\tlet curX = nextX(x0, velocity, angle,step);\n\t\t\t\tlet curY = nextY(y0, velocity, angle,step);\n\t\t\n\t\t\t\tif (step > 0 && !isComplete){\n\t\t\t\t\t\tisComplete = drawLine(nextX(x0, velocity, angle,step-1), curX,  nextY(y0, velocity, angle,step-1), curY, color);\n\t\t\t\t}\n\t\t}\n}",
      "bufferIds": [
        "tex-default",
        "0ce96281-8c6f-4830-bd4e-937144a403c2"
      ]
    }
  ],
  "functions": [
    {
      "id": "6410ae56-c9f1-4117-b3aa-c376ffc0479b",
      "name": "Bibliothèque 1",
      "code": "fn nextX(x0: i32, v0 : u32, angle : f32, t : u32) -> i32 {\n\t\treturn x0 + i32(f32(v0*t)*cos(angle));\n}\n\nfn nextY(y0 : i32, v0 : u32, angle : f32, t : u32) -> i32 {\n\treturn y0 + i32(f32(v0*t)*sin(angle) - 0.5*g*f32(t*t));\n}\n\nfn drawLine(x0 : i32, x1 : i32, y0 : i32, y1 : i32, coul : i32) -> bool{\n    let dx = abs(x1 - x0);\n    let dy = abs(y1 - y0);\n    var sx = 0;\n    var sy = 0;\n    if (x0 < x1){ sx = 1; } else { sx = -1; }\n    if (y0 < y1){ sy = 1; } else { sy = -1; }\n    var err = dx - dy;\n    var x = x0;\n    var y = y0;\n    while (x != x1 && y != y1) {\n\t\t\t\tif (x > 0 && x < (SIZEX-1) && y > 0){\n    \t\t\t Display[y*SIZEX + x] = coul;\n       \t\t var e2 = 2 * err;\n        \t\tif (e2 > -dy) {\n           \t\t err -= dy;\n           \t\t x += sx;\n        \t\t}\n       \t\t if (e2 < dx) {\n            \t\terr += dx;\n            \t\ty += sy;\n         \t\t}\n\t\t\t\t}else{\n\t\t\t\t\t\treturn false;\n\t\t\t\t}\n     }\n\t\treturn true;\n}\n\nfn CDAccess(x : i32, y : i32) -> i32 {\n\t\treturn y*NBPARAMCURVE + x;\n}"
    }
  ],
  "parameters": [
    {
      "id": "0a568031-495b-4fda-831c-8fd9ff54e55a",
      "name": "g",
