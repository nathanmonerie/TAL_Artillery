    {
      "id": "ece0e9f4-4d42-4749-9af4-3de5c113a438",
      "name": "CalculHandler",
      "workgroup": {
        "x": 8,
        "y": 8,
        "z": 1
      },
      "code": "// Nathan Monerie - 2026\n/* \tLeft & right arrow = horizontal movements\n\t \tUp & down arrow = angle change\n\t\tW & X = power change\n\t\tSpace = Fire/Restart\n*/\n\n@compute @workgroup_size(8, 8, 1)\nfn CalculHandler(@builtin(global_invocation_id) gid : vec3<u32>) {\n\t\tif (GlobalVariables[0] != 0 && i32(step) > GlobalVariables[0]+2) {\n\t\t\t\tcurveCalc(gid);\n\t\t\t\tterrainPhysic(gid);\n\t\t\t\tdamageCalc(gid);\n\t\t}\n}\n\n// Calcule des dégâts. Au maximum, un tir direct inflige 500 dégâts, soit la moitié de la vie d'un joueur\nfn damageCalc(gid : vec3<u32>){\n\t\tfor (var c : i32 = 0; c < NBCURVE; c++){\n\t\t\t\tif (CurveData[CDAccess(8,c)] == 3){\n\t\t\t\t\t\tlet xExp = CurveData[CDAccess(9,c)];\n\t\t\t\t\t\tlet yExp = CurveData[CDAccess(10,c)];\n\t\t\t\t\t\tlet curStep = f32(step) - CurveData[CDAccess(11,c)];\n\t\t\t\t\t\tlet explosionSize = CurveData[CDAccess(12,c)];\n\n\t\t\t\t\t\tif (curStep > 0 && curStep < NBFADEFRAME+1){ // teste si l'explosion est en cours\n\t\t\t\t\t\t\t\tfor (var p : i32 = 0; p < NBPLAYER; p++){\n\t\t\t\t\t\t\t\t\t\tlet xPla = PlayerData[PDAccess(0,p)];\n\t\t\t\t\t\t\t\t\t\tlet yPla = PlayerData[PDAccess(1,p)];\n\n\t\t\t\t\t\t\t\t\t\tlet xd = xPla - xExp;\n\t\t\t\t\t\t\t\t\t\tlet yd = yPla - yExp;\n\t\t\t\t\t\t\t\t\t\tlet d = sqrt(xd*xd + yd*yd);\n\t\n\t\t\t\t\t\t\t\t\t\tif (d < f32(explosionSize)){ \n\t\t\t\t\t\t\t\t\t\t\t\tif (gid.x == 0 && gid.y == 0){ PlayerData[PDAccess(10,p)] -= 500 - (d * (500/f32(explosionSize))); } // Dégats [500;0] selon la distance par rapport à l'impact.\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t}\n\t\t}\n}\n\n// Gere la courbe, de l'initialisation à la collision\nfn curveCalc(gid : vec3<u32>) {\n\t\tfor (var i :i32 = 0; i < NBCURVE; i++){\n\n\t\t\t\tvar x0 : i32 = i32(CurveData[CDAccess(0,i)]); // origine x\n\t\t\t\tvar y0 : i32 = i32(CurveData[CDAccess(1,i)]); // origine y\n\t\t\t\tvar angle : f32 = CurveData[CDAccess(2,i)]; // angle\n\t\t\t\tvar velocity : u32 = u32(CurveData[CDAccess(3,i)]); // velocité\n\n\t\t\t\tvar r : f32 = CurveData[CDAccess(4,i)]; // r\n\t\t\t\tvar g : f32 = CurveData[CDAccess(5,i)]; // g\n\t\t\t\tvar b : f32 = CurveData[CDAccess(6,i)]; // b\n\t\t\t\tvar col : vec3<f32> = vec3(r,g,b); \n\t\t\n\t\t\t\tvar start : u32 = u32(CurveData[CDAccess(7,i)]); // step de départ\n\n\t\t\t\tvar collisionsCoord : vec2<i32> = vec2(-1, -1); // coordonnées de collision ( (-1,-1) pour résultats inexistants)\n\n\t\t\t\tlet curX = curveX(x0, velocity, angle, step - start);\n\t\t\t\tlet curY = curveY(y0, velocity, angle, step - start );\n\t\t\t\t\n\t\t\t\tif (step > start && CurveData[CDAccess(8,i)] == 1){// lancement de la courbe\n\t\t\t\t\t\tCurveData[CDAccess(8,i)] = 2;\n\t\t\t\t}\n\t\t\t\tif (CurveData[CDAccess(8,i)] == 2){ // calcul de la courbe en cours\n\t\t\t\t\t\tlet prevX1 = curveX(x0, velocity, angle,(step - start) - 1);\n\t\t\t\t\t\tlet prevY1 = curveY(y0, velocity, angle,(step - start) - 1);\n\t\t\t\t\t\tcollisionsCoord = curve(gid, prevX1, curX, prevY1, curY, col);\n\t\t\t\t}\n\t\t\t\t\n\t\t\t\tif (collisionsCoord.x != -1 && collisionsCoord.y != -1 && CurveData[CDAccess(8,i)] == 2){ // collision de la courbe\n\t\t\t\t\t\tCurveData[CDAccess(8,i)] = 3;\n\t\t\t\t\t\tCurveData[CDAccess(9,i)] = f32(collisionsCoord.x); // collision x\n\t\t\t\t\t\tCurveData[CDAccess(10,i)] = f32(collisionsCoord.y); // collision y\n\t\t\t\t\t\tCurveData[CDAccess(11,i)] = f32(step);\n\t\t\t\t}\n\n\t\t\t\tif (TerrainMatrix[y0*SIZEX + x0] != 0 && CurveData[CDAccess(8,i)] == 2){ // cas ou la courbe est initialisé directement dans du terrain\n\t\t\t\t\t\tCurveData[CDAccess(8,i)] = 3;\n\t\t\t\t\t\tCurveData[CDAccess(9,i)] = f32(x0);\n\t\t\t\t\t\tCurveData[CDAccess(10,i)] = f32(y0);\n\t\t\t\t\t\tCurveData[CDAccess(11,i)] = f32(step);\n\t\t\t\t}\n\t\t}\n}\n\n// physique de terrain\nfn terrainPhysic(gid : vec3<u32>) {\n\t\tlet index = gid.y*SIZEX + gid.x;\n\t\tlet indexDown = (gid.y-1)*SIZEX + gid.x;\n\n\t\tlet x = i32(gid.x);\n\t\tlet y = i32(gid.y);\n\t\tif (y > 0){\n\t\t\t\tif (TerrainMatrix[index] == 1 && TerrainMatrix[indexDown] == 0){\n\t\t\t\t\t\t TerrainMatrix[index] = 0;\n\t\t\t\t\t\t TerrainMatrix[indexDown] = 1;\n\t\t\t  }\n\t\t\t\tif (TerrainMatrix[index] == 2 && TerrainMatrix[indexDown] == 0){\n\t\t\t\t\t\t TerrainMatrix[index] = 0;\n\t\t\t\t\t\t TerrainMatrix[indexDown] = 2;\n\t\t\t  }\n\t\t}\n}\n\n// calcul de la courbe. Renvoie les coordonnées de collisions, au pixel pres\nfn curve(gid : vec3<u32>, x0 : i32, x1 : i32, y0 : i32, y1 : i32, col : vec3<f32>) -> vec2<i32>{\n    let dx = abs(x1 - x0);\n    let dy = abs(y1 - y0);\n    var sx = 0;\n    var sy = 0;\n    if (x0 < x1){ sx = 1; } else { sx = -1; }\n    if (y0 < y1){ sy = 1; } else { sy = -1; }\n    var err = dx - dy;\n    var x = x0;\n    var y = y0;\n    while (x != x1 && y != y1) {\n\t\t\t\tif (x > 0 && x < (SIZEX-1) && y > 0 && TerrainMatrix[y*SIZEX + x] == 0){\n\t\t\t\t\t\tif ( y < (SIZEY-((DISPLAYSIZEY+2)*NBPOINTDISPLAYLINE)-3 )) { CurveMatrix[y*SIZEX + x] = vec4(col.x, col.y, col.z, f32(step)); } ;\n       \t\t  var e2 = 2 * err;\n        \t\tif (e2 > -dy) {\n           \t\t err -= dy;\n           \t\t x += sx;\n        \t\t}\n       \t\t if (e2 < dx) {\n            \t\terr += dx;\n            \t\ty += sy;\n         \t\t}\n\t\t\t\t}else{\n\t\t\t\t\t\tDisplay[y*SIZEX + x] = col;\n\t\t\t\t\t\treturn vec2(x, y);\n\t\t\t\t}\n     }\n\t\treturn vec2(-1,-1);\n}\n\n// calcul du x selon le temps\nfn curveX(x0: i32, v0 : u32, angle : f32, t : u32) -> i32 { return x0 + i32(f32(v0*t)*cos(angle)); }\n\n// calcul du y selon le temps\nfn curveY(y0 : i32, v0 : u32, angle : f32, t : u32) -> i32 { return y0 + i32(f32(v0*t)*sin(angle) - 0.5*g*f32(t*t)); }",
      "bufferIds": [
        "0ce96281-8c6f-4830-bd4e-937144a403c2",
        "dbc28fe0-edba-491d-abfe-fe5fb2f32c2f",
        "acab4bac-da45-4303-88be-f23b8db35de3",
        "5abcbbd6-9df6-4fe4-ab14-a51f994e8dd6",
        "9da514be-68f4-44ce-8ec4-ffcaa0093fad",
        "94f0ffab-9911-4533-a628-b34c0da715c7",
        "tex-default"
      ]
    },
    {
      "id": "847cd508-cbc5-4af3-ad26-b4f9598d5eed",
      "name": "PlayerHandler",
      "workgroup": {
        "x": 8,
        "y": 8,
        "z": 1
      },
      "code": "// Nathan Monerie - 2026\n/* \tLeft & right arrow = horizontal movements\n\t \tUp & down arrow = angle change\n\t\tW & X = power change\n\t\tSpace = Fire/Restart\n*/\n\n@compute @workgroup_size(8, 8, 1)\nfn PlayerHandler(@builtin(global_invocation_id) gid : vec3<u32>) {\n\t\tif (GlobalVariables[0] == 1 && i32(step) > GlobalVariables[0]+2) {\n\t\t\t\tif (gid.x == 0 && gid.y == 0 && GlobalVariables[0] != 2) { timerHandler(); }\n\t\t\t\tunblock();\n\t\t\t\tinputMov(gid);\n\t\t\t\tinputCannon(gid);\n\t\t\t\tplayerPhysic();\n\t\t\t\ttargerPhysic();\n\t\t}\n\t\tdeathHandler();\n\n\t\tif (gid.x + gid.y == 0 && GlobalVariables[3] != 0) { GlobalVariables[3] -= 1; }\n\n\t\t// gere le redemarrage de la partie\n\t\tif (GlobalVariables[0] == 2) {\n\t\t\t\tif (key == 0x20 && GlobalVariables[3] == 0){ // Space\n\t\t\t\t\tGlobalVariables[0] = 0;\n\t\t\t\t\tGlobalVariables[1] = i32(step);\n\t\t\t\t\tGlobalVariables[3] = 10;\n\t\t\t\t}\n\t\t}\n}\n\n// Gère le temps\nfn timerHandler() {\n\t\tlet time = GlobalVariables[4];\n\t\n\t\tvar isActive = false;\n\t\tfor (var i : i32 = 0; i < NBCURVE; i++){\n\t\t\t\tif (CurveData[CDAccess(8,i)] == 2) { isActive = true; }\n\t\t}\n\n\t\tif (!isActive) {\n\t\t\t\tif (time > 0) { GlobalVariables[4] -=1; }\n\t\t\t\tif (time == 0) { \n\t\t\t\t\t\tGlobalVariables[2] = (GlobalVariables[2]+1)%NBPLAYER;\n\t\t\t\t\t\tGlobalVariables[4] = TIMERTIME*20;\n\t\t\t\t}\n\t\t}\n}\n\n// Gère la mort du joueur\nfn deathHandler() {\n\t\tlet curPlayer = GlobalVariables[2];\n\n\t\t// création d'une courbe qui collisionne immediatement, pour l'explosion finale du joueur\n\t\tif (PlayerData[PDAccess(10,curPlayer)] <= 0) {\n\t\t\tGlobalVariables[4] = TIMERTIME*20;\n\n\t\t\tPlayerData[PDAccess(10,curPlayer)] = 0;\n\n\t\t\tCurveData[CDAccess(0,curPlayer*5)] = PlayerData[PDAccess(0,curPlayer)];\n\t\t\tCurveData[CDAccess(1,curPlayer*5)] = PlayerData[PDAccess(1,curPlayer)];\n\n\t\t\tCurveData[CDAccess(2,curPlayer*5)] = 0;\n\t\t\tCurveData[CDAccess(3,curPlayer*5)] = 1;\n\n\t\t\tCurveData[CDAccess(4,curPlayer*5)] = PlayerData[PDAccess(7,curPlayer)];\n\t\t\tCurveData[CDAccess(5,curPlayer*5)] = PlayerData[PDAccess(8,curPlayer)];\n\t\t\tCurveData[CDAccess(6,curPlayer*5)] = PlayerData[PDAccess(9,curPlayer)];\n\n\t\t\tCurveData[CDAccess(7,curPlayer*5)] = f32(step);\n\t\t\tCurveData[CDAccess(8,curPlayer*5)] = 1;\n\n\t\t\tCurveData[CDAccess(9,curPlayer*5)] = PlayerData[PDAccess(0,curPlayer)];\n\t\t\tCurveData[CDAccess(10,curPlayer*5)] = PlayerData[PDAccess(1,curPlayer)];\n\t\t\tCurveData[CDAccess(11,curPlayer*5)] = -1;\n\n\t\t\tCurveData[CDAccess(12,curPlayer*5)] = 16;\n\t\t\t\n\t\t\tGlobalVariables[2] = (GlobalVariables[2]+1)%NBPLAYER;\n\t\t\tGlobalVariables[0] = 2;\n\t\t}\n}\n\n// gere le déblocage du joeur apres avoir tirer\nfn unblock() {\n\t\tvar isActive = false;\n\t\tfor (var i : i32 = 0; i < NBCURVE; i++){\n\t\t\t\tif (CurveData[CDAccess(8,i)] == 2) { isActive = true; }\n\t\t}\n\t\tfor (var i : i32 = 0; i < NBPLAYER; i++) {\n\t\t\t\tif (!isActive){\n\t\t\t\t\t\tif ( PlayerData[PDAccess(4,i)] != 0) { GlobalVariables[4] = TIMERTIME*20; }\n\t\t\t\t\t\tPlayerData[PDAccess(4,i)] = 0;\n\t\t\t\t}\n\t\t\t\telse { PlayerData[PDAccess(4,i)] = 1;}\n\t\t}\n}\n\n// gere le changement d'angle, de puissance, et le tir du canon\nfn inputCannon(gid : vec3<u32>) {\n\t\tlet curPlayer = GlobalVariables[2];\n\n\t\tif (PlayerData[PDAccess(4,curPlayer )] == 0){\n\t\t\t\tif (gid.x == 0 && gid.y == 0){\n\t\t\t\t\t\tif (key == 0x28){ // Arrow down\n\t\t\t\t\t\t\t\tif (PlayerData[PDAccess(5,curPlayer)] == 0) { PlayerData[PDAccess(5,curPlayer)] = 360; }\n\t\t\t\t\t\t\t\tif (curPlayer%2 == 0) { PlayerData[PDAccess(5,curPlayer)] -= 1; }\n\t\t\t\t\t\t\t\telse { PlayerData[PDAccess(5,curPlayer)] += 1; }\n\t\t\t\t\t\t}\n\t\t\t\t\n\t\t\t\t\t\tif (key == 0x26){ // Arrow up\n\t\t\t\t\t\t\t\tif (curPlayer%2 == 0) { PlayerData[PDAccess(5,curPlayer)] = (PlayerData[PDAccess(5,curPlayer)]+1)%360; }\n\t\t\t\t\t\t\t\telse { PlayerData[PDAccess(5,curPlayer)] = (PlayerData[PDAccess(5,curPlayer)]-1)%360; }\n\t\t\t\t\t\t}\n\t\t\t\t\n\t\t\t\t\t\tif (key == 0x58 && PlayerData[PDAccess(6,curPlayer)] > 0) /*X*/ { PlayerData[PDAccess(6,curPlayer)] -= 1; }\n\t\t\t\t\n\t\t\t\t\t\tif (key == 0x57 && PlayerData[PDAccess(6,curPlayer)] < 100) /*W*/ { PlayerData[PDAccess(6,curPlayer)] += 1; }\n\n\t\t\t\t\t\tif (key == 0x20){ // Space\n\t\t\t\t\t\t\t\tif (GlobalVariables[3] == 0) {\n\t\t\t\t\t\t\t\t\t\tGlobalVariables[3] = 10;\n\t\t\t\t\t\t\t\t\t\tPlayerData[PDAccess(4,curPlayer)] = 1;\n\n\t\t\t\t\t\t\t\t\t\tlet x = PlayerData[PDAccess(0,curPlayer)];\n\t\t\t\t\t\t\t\t\t\tlet y = PlayerData[PDAccess(1,curPlayer)];\n\t\t\t\t\t\t\t\t\t\tlet angle = PlayerData[PDAccess(5,curPlayer)];\n\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\tfor (var i : i32 = 0; i < NBPLAYER; i++) { PlayerData[PDAccess(4,i)] = 1; }\n\n\t\t\t\t\t\t\t\t\t\tCurveData[CDAccess(0,curPlayer*5)] = x+cos(radians(angle))*8; // origine x\n\t\t\t\t\t\t\t\t\t\tCurveData[CDAccess(1,curPlayer*5)] = y+sin(radians(angle))*8; // origine y\n\t\t\t\t\t\t\t\t\t\tCurveData[CDAccess(2,curPlayer*5)] = radians(angle); // angle\n\t\t\t\t\t\t\t\t\t\tCurveData[CDAccess(3,curPlayer*5)] = PlayerData[PDAccess(6,curPlayer)]; // velocité (power)\n\n\t\t\t\t\t\t\t\t\t\tCurveData[CDAccess(4,curPlayer*5)] = PlayerData[PDAccess(7,curPlayer)]; // r\n\t\t\t\t\t\t\t\t\t\tCurveData[CDAccess(5,curPlayer*5)] = PlayerData[PDAccess(8,curPlayer)]; // g\n\t\t\t\t\t\t\t\t\t\tCurveData[CDAccess(6,curPlayer*5)] = PlayerData[PDAccess(9,curPlayer)]; // b\n\t\t\n\t\t\t\t\t\t\t\t\t\tCurveData[CDAccess(7,curPlayer*5)] = f32(step); // temps de départ\n\t\t\t\t\t\t\t\t\t\tCurveData[CDAccess(8,curPlayer*5)] = 1; // état (-1 : attente, 2 : en cours, 3 : finit)\n\n\t\t\t\t\t\t\t\t\t\tCurveData[CDAccess(9,curPlayer*5)] = -1; // collision x (-1, résultat ignoré)\n\t\t\t\t\t\t\t\t\t\tCurveData[CDAccess(10,curPlayer*5)] = -1; // collision y (-1, résultat ignoré)\n\t\t\t\t\t\t\t\t\t\tCurveData[CDAccess(11,curPlayer*5)] = -1; // temps de l'explosion (-1, résultat ignoré)\n\n\t\t\t\t\t\t\t\t\t\tCurveData[CDAccess(12,curPlayer*5)] = 8; // taille de l'explosion\n\t\t\t\n\t\t\t\t\t\t\t\t\t\tGlobalVariables[2] = (GlobalVariables[2]+1)%NBPLAYER;// Passe au prochain joueur\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t}\n\t\t}\n}\n\n// gere le mouvement du joeur, avec l'aide d'une cible pour les mouvement vericaux \nfn inputMov(gid : vec3<u32>) {\n\t\tlet curPlayer = GlobalVariables[2];\n\n\t\tlet x = i32(PlayerData[PDAccess(0,curPlayer)]);\n\t\tlet y = i32(PlayerData[PDAccess(1,curPlayer)]);\n\n\t\tlet yTarg = i32(PlayerData[PDAccess(3,curPlayer)]);\n\t\tlet xTarg = i32(PlayerData[PDAccess(2,curPlayer)]);\n\n\t\tif (PlayerData[PDAccess(4,curPlayer)] == 0){\n\t\t\t\tif (gid.x == 0 && gid.y == 0){\n\t\t\t\t\t\tif (key == 0x27 && x < (SIZEX-1) ){ // Arrow right\n\t\t\t\t\t\t\t\tif (yTarg - y > 1 && xTarg - x > 0){ // si la cible est trop haute\n\t\t\t\t\t\t\t\t\t\tPlayerData[PDAccess(1,curPlayer)] += 1; // mouvement vertical\n\t\t\t\t\t\t\t\t}else{\n\t\t\t\t\t\t\t\t\t\tPlayerData[PDAccess(0,curPlayer)] += 1; // mouvement horizontal\n\t\t\t\t\t\t\t\t\t\tPlayerData[PDAccess(2,curPlayer)] = PlayerData[PDAccess(0,curPlayer )]+1; // mouvement horizontal de la cible\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\n\t\t\t\t\t\tif (key == 0x25 && x > 0){ // Arrow left\n\t\t\t\t\t\t\t\tif (yTarg - y > 1 && xTarg - x < 0){ // si la cible est trop haute\n\t\t\t\t\t\t\t\t\t\tPlayerData[PDAccess(1,curPlayer)] += 1; // mouvement vertical\n\t\t\t\t\t\t\t\t}else{\n\t\t\t\t\t\t\t\t\t\tPlayerData[PDAccess(0,curPlayer)] -= 1; // mouvement horizontal\n\t\t\t\t\t\t\t\t\t\tPlayerData[PDAccess(2,curPlayer)] = PlayerData[PDAccess(0,curPlayer)]-1; // mouvement horizontal de la cible\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t}\n\t\t}\n}\n\n// gere la physique du joueur\nfn playerPhysic(){\n\t\tfor (var i : i32 = 0; i < NBPLAYER; i++) {\n\t\t\t\tlet x = i32(PlayerData[PDAccess(0,i)]);\n\t\t\t\tlet y = i32(PlayerData[PDAccess(1,i)]);\n\n\t\t\t\tlet yTarg = i32(PlayerData[PDAccess(3,i)]);\n\t\t\t\tif (yTarg - y < 1){ // on ignore la physique si on est en mouvement verticale\n\t\t\t\t\t\tif (TerrainMatrix[(y-1)*SIZEX + x] == 0 && y>0){ PlayerData[PDAccess(1,i)] -= 1; } // si le joueur est au dessus du vide, il tombe\n\t\t\t\t\t\tif (TerrainMatrix[y*SIZEX + x] != 0){ PlayerData[PDAccess(1,i)] += 1; } // si le joueur est dans du terrain, il monte\n\t\t\t\t}\n\t\t}\n}\n\n// gere la physique de la cible\nfn targerPhysic(){\n\t\tfor (var i : i32 = 0; i < NBPLAYER; i++) {\n\t\t\t\tlet xTarg = i32(PlayerData[PDAccess(2,i)]);\n\t\t\t\tlet yTarg = i32(PlayerData[PDAccess(3,i)]);\n\n\t\t\t\tif (TerrainMatrix[(yTarg-1)*SIZEX + xTarg] == 0 && yTarg>0){ PlayerData[PDAccess(3,i)] -= 1; } // si la cible est au dessus du vide, elle tombe\n\t\t\t\tif (TerrainMatrix[yTarg*SIZEX + xTarg] != 0){ PlayerData[PDAccess(3,i)] += 1; } // si la cible est dans du terrain, elle monte\n\t\t}\n}",
      "bufferIds": [
        "9da514be-68f4-44ce-8ec4-ffcaa0093fad",
        "5abcbbd6-9df6-4fe4-ab14-a51f994e8dd6",
        "0ce96281-8c6f-4830-bd4e-937144a403c2",
        "94f0ffab-9911-4533-a628-b34c0da715c7"
      ]
    }
  ],
  "functions": [
    {
      "id": "6410ae56-c9f1-4117-b3aa-c376ffc0479b",
      "name": "Bibliothèque 1",
      "code": "// Nathan Monerie - 2026\n/* \tLeft & right arrow = horizontal movements\n\t \tUp & down arrow = angle change\n\t\tW & X = power change\n\t\tSpace = Fire/Restart\n*/\n\n// Renvoie le produit vectoriel entre 3 points (sert ici a savoir si un point est en dessous d'un segment ou pas)\nfn crossProduct(x1 : i32, x2 : i32, x3 : i32, y1 : i32, y2 : i32, y3 : i32) -> i32 {\n\t\tvar v1 : vec2<i32>;\n\t\tv1[0] = x1 - x2;\n\t\tv1[1] = y1 - y2;\n\t\tvar v2 : vec2<i32>;\n\t\tv2[0] = x2 - x3;\n\t\tv2[1] = y2 - y3;\n\n\t\treturn  (v1[0]*v2[1]) - (v1[1]*v2[0]);\n}\n\n// Fonction d'accès au buffer CurveData\nfn CDAccess(x : i32, y : i32) -> i32 {\n\t\treturn y*NBPARAMCURVE + x;\n}\n\n// Fonction d'accès au buffer TerrainData\nfn TDAccess(x : i32, y : i32) -> i32 {\n\t\treturn y*2 + x;\n}\n\n// Fonction d'accès au buffer PlayerData\nfn PDAccess(x : i32, y : i32) -> i32 {\n\t\treturn y*NBPARAMPLAYER + x;\n}\n\n// Fonction d'accès au buffer PointDisplayData\nfn PDDAccess(x : i32, y : i32) -> i32 {\n\t\treturn y*2 + x;\n}\n\n// Renvoie un nombre aléatoire (ici utilisé pour la génération de terrain)\nfn alea(x: u32, y: u32, step: u32) -> u32 {\n        var h: u32 = x;\n        h = h * 374761393u + y * 668265263u + step * 362437u;\n        h = (h ^(h >> 13u)) * 1274126177u;\n        h = h ^(h >> 16u);\n        return h;\n}"
    }
  ],
