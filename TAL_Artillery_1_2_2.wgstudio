  "shaders": [
    {
      "id": "4b21c4f4-130f-4927-8494-5e3fd1e4df9c",
      "name": "Init",
      "workgroup": {
        "x": 8,
        "y": 8,
        "z": 1
      },
      "code": "// Nathan Monerie - 2026\n/* \tLeft & right arrow = horizontal movements\n\t \tUp & down arrow = angle change\n\t\tW & X = power change\n\t\tSpace = Fire/Restart\n*/\n\n@compute @workgroup_size(SIZEWORKX, SIZEWORKY, 1)\nfn Init(@builtin(global_invocation_id) gid : vec3<u32>) {\n\t\tif (GlobalVariables[0] == 0 || step == 0){\n\t\t\t\tterrainMatrixReset(gid);\n\t\t\t\tcurveMatrixReset(gid);\n\t\t\t\tif (gid.x == 0 && gid.y == 0){\n\t\t\t\t\t\tcurveReset();\n\t\t\t\t\t\tterrainDataReset();\n\t\t\t\t\t\tpointDisplayInit();\n\t\t\t\t\t\tterrainInit();\n\t\t\t\t\t\tplayerInit();\n\t\t\t\t}\n\t\t\t\t\n\t\t\t\tGlobalVariables[4] = TIMERTIME*20;// Initialisation du timer\n\n\t\t\t\tif (gid.x == SIZEX-1 && gid.y == SIZEY-1) { GlobalVariables[0] = 1; }// Passage de l'état du jeu d'initialisation à en cours\n\t\t}\n\t\tif (i32(step) == GlobalVariables[1]+1 ){ terrainFill(gid); }\n\t\tif (i32(step) == GlobalVariables[1]+2 ){ grassInit(gid); }\n}\n\n// Fonction de réinitialisation des points du terrain (ici, est appelé quand une partie est recommencée)\nfn terrainDataReset() { \n\t\tfor (var i : i32 = 0; i < NBTERRAINPOINT; i++) {\n\t\t\t\tTerrainData[TDAccess(0,i)] = 0;\n\t\t\t\tTerrainData[TDAccess(1,i)] = 0;\n\t\t}\n}\n\n// Fonction de réinitialisation de la matrice du terrain (ici, est appelé quand une partie est recommencée)\nfn terrainMatrixReset(gid : vec3<u32>){ TerrainMatrix[ gid.y*SIZEX + gid.x] = 0; }\n\n// Fonction de réinitialisation des informations des courbes\nfn curveReset() {\n\t\tvar y : i32 = 0;\n\t\tfor (var i : i32 = 0; i < NBCURVE; i++) {\n\t\t\t\tfor (var j : i32 = 0; j < NBPARAMCURVE; j++) {\n\t\t\t\t\t\tCurveData[CDAccess(j,i)] = 0;\n\t\t\t\t}\n\t\t}\n} \n\n// Fonction de réinitialisation de la matrice des courbes\nfn curveMatrixReset(gid : vec3<u32>){ CurveMatrix[gid.y*SIZEX + gid.x] = vec4(0.0, 0.0, 0.0 ,0.0); }\n\n// Fonction d'initialisation des points de terrains, qui ont une hauteur aléatoire\nfn terrainInit() {\n\t\tfor (var i : i32 = 0; i < NBTERRAINPOINT; i++){\n\t\t\t\tTerrainData[TDAccess(0,i)] = ((SIZEX/(NBTERRAINPOINT-1))*i);\n\t\t\t\tTerrainData[TDAccess(1,i)] =\ti32( alea(u32(i), step%(SIZEY),Random[0] )%(SIZEY-4) )/2;\n\t\t}\n}\n\n// Fonction de remplissage du terrain, ou chaque pixel qui est sous un segment entre 2 points est inscrit dans la matrice de terrain\nfn terrainFill(gid : vec3<u32>) {\n\t\tlet index = gid.y*SIZEX + gid.x;\n\n\t\tvar terrainSeg = i32(floor( f32(i32(gid.x-1)/( SIZEX/(NBTERRAINPOINT-1) )) ));\n\t\tvar x1 = TerrainData[TDAccess(0,terrainSeg)];\n\t\tvar x2 = TerrainData[TDAccess(0,terrainSeg+1)];\n\t\tvar y1 =  TerrainData[TDAccess(1,terrainSeg)];\n\t\tvar y2 =  TerrainData[TDAccess(1,terrainSeg+1)];\n\n\t\tvar xp = 0;\n\t\tif (i32(gid.x) <= TerrainData[TDAccess(0,NBTERRAINPOINT-1)]){\n\t\t\t\txp = crossProduct(x1, x2, i32(gid.x), y1, y2 ,i32(gid.y));\n\t\t}else{\n\t\t\t\txp = crossProduct(x2, TerrainData[TDAccess(0,NBTERRAINPOINT-1)], i32(gid.x), y2, y2 ,i32(gid.y));\n\t\t}\n\n\t\tif (xp < 0){ TerrainMatrix[index] = 2; }\n\t\telse{ TerrainMatrix[index] = 0; }\n}\n\n// Initialisation de l'herbe. La matrice de terrain doit deja etre remplit, donc cette fonction est appelée un step plus tard\nfn grassInit(gid : vec3<u32>){\n\t\tlet index = gid.y*SIZEX + gid.x;\n\t\tlet indexUp = (gid.y+2)*SIZEX + gid.x;// Ici, on met y+2 pour avoir une herbe de 2 pixels de haut\n\t\tlet indexLeft = gid.y*SIZEX + (gid.x-1);\n\t\tlet indexRight = gid.y*SIZEX + (gid.x+1);\n\n\t\tif(gid.y < SIZEY/2){\n\t\t\t\t// 0: vide, 1: herbe, 2: terre\n\t\t\t\tif (TerrainMatrix[indexUp] != 2 && TerrainMatrix[index] == 2) { TerrainMatrix[index] = 1; }\n\n\t\t\t\t// Rajout d'herbe supplémentaire pour rendre les pentes plus jolies. Purement cosmétique.\n\t\t\t\tif (gid.x > 1 && TerrainMatrix[indexLeft] != 2 && TerrainMatrix[index] == 2) { TerrainMatrix[index] = 1; }\n\t\t\t\tif (gid.x < (SIZEX-1) && TerrainMatrix[indexRight] != 2 && TerrainMatrix[index] == 2) { TerrainMatrix[index] = 1; }\n\t\t}\n}\n\n// Initialisation des joueurs\nfn playerInit(){\n\t\tPlayerData[PDAccess(0,0)] = (SIZEX/NBTERRAINPOINT)/2; // x personnel\n\t\tPlayerData[PDAccess(1,0)] = SIZEY/2; // y personnel\n\t\tPlayerData[PDAccess(2,0)] = PlayerData[PDAccess(0,0)]; // x de la cible de mouvement\n\t\tPlayerData[PDAccess(3,0)] = PlayerData[PDAccess(1,0)]; // y de la cible de mouvement\n\t\tPlayerData[PDAccess(4,0)] = 0; // etat (0: n'as pas tiré, 1: à tiré)\n\t\tPlayerData[PDAccess(5,0)] = 45; // angle\n\t\tPlayerData[PDAccess(6,0)] = 50; // velocité (power)\n\t\tPlayerData[PDAccess(7,0)] = 0.99; // r\n\t\tPlayerData[PDAccess(8,0)] = 0.0; // g\n\t\tPlayerData[PDAccess(9,0)] = 0.0; // b\n\t\tPlayerData[PDAccess(10,0)] = 999; // points de vie\n\n\t\tPlayerData[PDAccess(0,1)] = SIZEX-(SIZEX/NBTERRAINPOINT)/2;\n\t\tPlayerData[PDAccess(1,1)] = SIZEY/2;\n\t\tPlayerData[PDAccess(2,1)] = PlayerData[PDAccess(0,1)];\n\t\tPlayerData[PDAccess(3,1)] = PlayerData[PDAccess(1,1)];\n\t\tPlayerData[PDAccess(4,1)] = 0;\n\t\tPlayerData[PDAccess(5,1)] = 135;\n\t\tPlayerData[PDAccess(6,1)] = 50;\n\t\tPlayerData[PDAccess(7,1)] = 0.0;\n\t\tPlayerData[PDAccess(8,1)] = 0.0;\n\t\tPlayerData[PDAccess(9,1)] = 0.99;\n\t\tPlayerData[PDAccess(10,1)] = 999;\n}\n\n// Initialisation des afficheurs à points. Pour une raison inconnue, provoque une fuite de mémoire (peut être)\nfn pointDisplayInit(){\n\t\tlet nbPointDisplayI32 : i32 = i32(NBPOINTDISPLAY);\n\t\tfor (var i : i32 = 0; i < nbPointDisplayI32 ; i++){\n\t\t\t\tfor (var j : i32 = 0; j < NBPOINTDISPLAYLINE; j++){\n\t\t\t\t\t\tPointDisplayData[PDDAccess(0,i+(j*nbPointDisplayI32 ))] = (i*(DISPLAYSIZEX+2))+1;\n\t\t\t\t\t\tPointDisplayData[PDDAccess(1,i+(j*nbPointDisplayI32 ))] = (SIZEY-1) - ((j*(DISPLAYSIZEY+2))+(DISPLAYSIZEY+2));\n\t\t\t\t}\n\t\t}\n}",
      "bufferIds": [
        "0ce96281-8c6f-4830-bd4e-937144a403c2",
        "dbc28fe0-edba-491d-abfe-fe5fb2f32c2f",
        "acab4bac-da45-4303-88be-f23b8db35de3",
        "5abcbbd6-9df6-4fe4-ab14-a51f994e8dd6",
        "d4138b69-1b0f-45cd-884b-f0d79be199a9",
        "9da514be-68f4-44ce-8ec4-ffcaa0093fad",
        "5d64e419-9907-4441-bdd6-0a86d8eb0ba0",
        "94f0ffab-9911-4533-a628-b34c0da715c7"
      ]
    },
    {
      "id": "efcd35c5-52fe-4ffa-af63-6cde3893f240",
      "name": "DisplayHandler",
      "workgroup": {
        "x": 8,
        "y": 8,
        "z": 1
      },
      "code": "// Nathan Monerie - 2026\n/* \tLeft & right arrow = horizontal movements\n\t \tUp & down arrow = angle change\n\t\tW & X = power change\n\t\tSpace = Fire/Restart\n*/\n\n@compute @workgroup_size(SIZEWORKX, SIZEWORKY, 1)\nfn DisplayHandler(@builtin(global_invocation_id) gid : vec3<u32>) {\n\t\tif (GlobalVariables[0] != 0 && i32(step) > GlobalVariables[0]+2) {\n\t\t\t\treset(gid);\n\t\t\t\tcurveDisplay(gid);\n\t\t\t\tterrainDisplay(gid);\n\t\t\t\tplayerDisplay(gid);\n\t\t\t\texplosionHandler(gid,8);\n\t\t\t\ttimerDisplay();\n\t\t\t\tif (gid.x == SIZEX-1 && gid.y == SIZEY-1) { pointDisplayDisplay();}\n\t\t}\n}\n\n// Réinitialisation de la matrice d'affichage\nfn reset(gid : vec3<u32>){ Display[gid.y * SIZEX + gid.x] = vec3(0.0, 0.0, 0.0); } \n\n// affichage des joueurs. La vie est également indiqué par la couleur du personnage (plus elle est basse, plus le joueur est sombre)\nfn playerDisplay(gid : vec3<u32>){\n\t\tfor (var i : i32 = 0; i < NBPLAYER; i++) {\n\t\t\t\tlet life = PlayerData[PDAccess(10,i)];\n\t\t\t\tif (life > 0) {\n\t\t\t\t\t\tlet x = PlayerData[PDAccess(0,i)];\n\t\t\t\t\t\tlet y = PlayerData[PDAccess(1,i)];\n\t\t\t\t\t\tlet angle = PlayerData[PDAccess(5,i)];\n\t\t\t\t\t\t\n\t\t\t\t\t\tlet life = PlayerData[PDAccess(10,i)]; \t\t\t\t\t\t\n\n\t\t\t\t\t\tlet r = PlayerData[PDAccess(7,i)]*(0.5 + life/1998);\n\t\t\t\t\t\tlet g = PlayerData[PDAccess(8,i)]*(0.5 + life/1998);\n\t\t\t\t\t\tlet b = PlayerData[PDAccess(9,i)]*(0.5 + life/1998);\n\n\t\t\t\t\t\tlet xd = f32(gid.x) - x;\n\t\t\t\t\t\tlet yd = f32(gid.y) - y;\n\t\t\t\t\t\tlet d = sqrt(xd*xd + yd*yd);\n\n\t\t\t\t\t\tif (d < 4){\t\n\t\t\t\t\t\t\t\tDisplay[gid.y * SIZEX + gid.x] = vec3(r,g,b); \n\t\t\t\t\t\t}\n\t\t\t\t\t\t// affichage du canon\n\t\t\t\t\t\tif (i32(x+cos(radians(angle))*8) > 0 && i32(x+cos(radians(angle))*8) < SIZEX) { \n\t\t\t\t\t\t\tline(i32(x), i32(y), i32(x+cos(radians(angle))*8), i32(y+sin(radians(angle))*8), vec3(r,g,b)); \n\t\t\t\t\t\t}\n\t\t\t\t}\n\t\t}\n}\n\n// Fonction d'affichage d'une ligne\nfn line(x0 : i32, y0 : i32, x1 : i32, y1 : i32, col : vec3<f32>){\n\t\tvar locX0 = x0;\n\t\tvar locX1 = x1;\n\t\tvar locY0 = y0;\n\t\tvar locY1 = y1;\n\t\tvar steep = false;\n\n\t\tif (abs(locX0-locX1) < abs(locY0-locY1)) { // on est obligé d'inverser les x et y si la ligne dépasse un certain angle\n\t\t\t\tvar temp = locX0;\n\t\t\t\tlocX0 = locY0;\n\t\t\t\tlocY0 = temp;\n\n\t\t\t\ttemp = locX1;\n\t\t\t\tlocX1 = locY1;\n\t\t\t\tlocY1 = temp;\n\n\t\t\t\tsteep = true;\n\t\t}\n\n\t\tif(locX0 > locX1){\n\t\t\t\tvar temp = locX0;\n\t\t\t\tlocX0 = locX1;\n\t\t\t\tlocX1 = temp;\n\n\t\t\t\ttemp = locY0;\n\t\t\t\tlocY0 = locY1;\n\t\t\t\tlocY1 = temp;\n\t\t}\n\n\t\tlet dx : i32 = locX1 - locX0;\n\t\tlet dy : i32 = locY1 - locY0;\n\t\tlet derror : f32 = abs(f32(dy)/f32(dx));\t\n\t\tvar error : f32 = 0;\n\t\tvar y : i32 = locY0;\n\n\t\tfor (var x : i32 = locX0; x <= locX1; x++) {\n\t\t\t\tif (steep) { Display[x*SIZEX + y] = col; }\n\t\t\t\telse { Display[y*SIZEX + x] = col; }\n\n\t\t\t\terror += derror;\n\t\t\t\tif (error > 0.5) {\n\t\t\t\t\t\tif (locY1 > locY0){ y += 1; }\n\t\t\t\t\t\telse{ y -= 1; }\n\t\t\t\t\t\terror -= 1.0;\n\t\t\t\t}\n\t\t}\n}\n\n// Fonction d'affichage de la courbe. Gère également l'assombrissement progressif de celle ci\nfn curveDisplay(gid : vec3<u32>) {\n\t\tlet index = gid.y*SIZEX + gid.x;\n\n\t\tif (CurveMatrix[index][0] != 0.0 || CurveMatrix[index][1] != 0.0 || CurveMatrix[index][2] != 0.0) {\n\t\t\t\tfor (var i : i32 = 0; i < 3; i++) { \n\t\t\t\t\t\tlet curStep = f32(step) - CurveMatrix[index][3] ;\n\t\t\t\t\t\tif (curStep < 4) { Display[index][i] = CurveMatrix[index][i] / pow(2,curStep-1); }\n\t\t\t\t\t\telse {  Display[index] = vec3(0.0, 0.0, 0.0); }\n\t\t\t\t}\n\t\t}\n}\n\n// Fonction d'affichage des explosions, ainsi que leur animation. Gère également la modification du terrain\nfn explosionHandler(gid : vec3<u32>, explosionSize : i32) {\n\t\tlet index = gid.y*SIZEX + gid.x;\n\n\t\tfor (var i :i32 = 0; i < NBCURVE; i++){\n\t\t\t\tif (CurveData[CDAccess(8,i)] == 3){\n\t\t\t\t\t\tlet x = CurveData[CDAccess(9,i)];\n\t\t\t\t\t\tlet y = CurveData[CDAccess(10,i)];\n\t\t\t\t\t\tlet curStep = f32(step) - CurveData[CDAccess(11,i)];\n\t\t\t\t\t\tlet explosionSize = CurveData[CDAccess(12,i)];\n\t\n\t\t\t\t\t\tlet r : f32 = CurveData[CDAccess(4,i)];\n\t\t\t\t\t\tlet g : f32 = CurveData[CDAccess(5,i)];\n\t\t\t\t\t\tlet b : f32 = CurveData[CDAccess(6,i)];\n\t\t\t\t\t\tlet col : vec3<f32> = vec3(r,g,b);\n\n\t\t\t\t\t\tlet xd = f32(gid.x) - x;\n\t\t\t\t\t\tlet yd = f32(gid.y) - y;\n\t\t\t\t\t\tlet d = sqrt(xd*xd + yd*yd);\n\n\t\t\t\t\t\tif (curStep > 0 && curStep < NBFADEFRAME+1){\n\t\t\t\t\t\t\t\tif (d < f32(explosionSize)){\t\n\t\t\t\t\t\t\t\t\t\tDisplay[gid.y * SIZEX + gid.x] = col; \n\t\t\t\t\t\t\t\t\t\tTerrainMatrix[index] = 0;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t\tif (curStep > 0 && curStep < NBFADEFRAME+1){\n\t\t\t\t\t\t\t\tif( d < f32(explosionSize/NBFADEFRAME)*curStep ){ Display[index] = vec3(0.0, 0.0, 0.0); }\n\t\t\t\t\t\t}\n\t\t\t\t}\n\t\t}\n}\n\n// Fonction d'affichage du terrain. Affiche un motif purement cosmétique de damier\nfn terrainDisplay(gid : vec3<u32>) {\n\t\tlet index = gid.y*SIZEX + gid.x;\n\n\t\tif (TerrainMatrix[index] == 1) { Display[index] = vec3(0.0, 0.5, 0.0); }\n\t\tif (TerrainMatrix[index] == 2) { \n\t\t\t\tif ( ((gid.x/4)+(gid.y/4))%2 == 0){ Display[index] = vec3(0.3, 0.1, 0.1); }\n\t\t\t\telse { Display[index] = vec3(0.15, 0.05, 0.05); }\n\t\t}\n}\n\n// Affichage du temps\nfn timerDisplay() {\n\t\tlet curPlayer = GlobalVariables[2];\n\n\t\tlet r = PlayerData[PDAccess(7,curPlayer)];\n\t\tlet g = PlayerData[PDAccess(8,curPlayer)];\n\t\tlet b = PlayerData[PDAccess(9,curPlayer)];\n\n\t\tlet x = ((GlobalVariables[4]/TIMERTIME)*(SIZEX/TIMERTIME))/2;\n\t\tlet y = SIZEY - ((DISPLAYSIZEY+2)*NBPOINTDISPLAYLINE)-3;\n\n\t\tline(0, y, x, y, vec3(r,g,b));\n}\n\n// affichage des afficheurs à points\nfn pointDisplayDisplay() {\n\t\tlet curPlayer = GlobalVariables[2];\n\t\tlet r = PlayerData[PDAccess(7,curPlayer)];\n\t\tlet g = PlayerData[PDAccess(8,curPlayer)];\n\t\tlet b = PlayerData[PDAccess(9,curPlayer)];\n\t\t\n\t\tif (GlobalVariables[0] == 1) {\n\t\t\t\t// velocity (power)\n\t\t\t\tpointDisplayWriter(0, -16, vec3(0.9,0.9,0.9));\n\t\t\t\tpointDisplayWriter(1, -15, vec3(0.9,0.9,0.9));\n\t\t\t\tpointDisplayWriter(2, -23, vec3(0.9,0.9,0.9));\n\t\t\t\tpointDisplayWriter(3, -5, vec3(0.9,0.9,0.9));\n\t\t\t\tpointDisplayWriter(4, -18, vec3(0.9,0.9,0.9));\n\t\t\t\tpointDisplayWriter(5, 15, vec3(0.9,0.9,0.9));\n\n\t\t\t\tvar power = PlayerData[PDAccess(6,curPlayer)];\n\t\t\t\tvar powerh = (power/100)%10;\n\t\t\t\tvar powerd = (power/10)%10;\n\t\t\t\tvar poweru = power%10;\n\t\t\t\tpointDisplayWriter(6, i32(powerh), vec3(0.9,0.9,0.9));\n\t\t\t\tpointDisplayWriter(7, i32(powerd), vec3(0.9,0.9,0.9));\n\t\t\t\tpointDisplayWriter(8, i32(poweru), vec3(0.9,0.9,0.9));\n\n\t\t\t\t// angle\n\t\t\t\tpointDisplayWriter(10, -1, vec3(0.9,0.9,0.9));\n\t\t\t\tpointDisplayWriter(11, -14, vec3(0.9,0.9,0.9));\n\t\t\t\tpointDisplayWriter(12, -7, vec3(0.9,0.9,0.9));\n\t\t\t\tpointDisplayWriter(13, -12, vec3(0.9,0.9,0.9));\n\t\t\t\tpointDisplayWriter(14, -5, vec3(0.9,0.9,0.9));\n\t\t\t\tpointDisplayWriter(15, 15, vec3(0.9,0.9,0.9));\n\n\t\t\t\tvar angle = PlayerData[PDAccess(5,curPlayer)];\n\t\t\t\tvar angleh = (angle/100)%10;\n\t\t\t\tvar angled = (angle/10)%10;\n\t\t\t\tvar angleu = angle%10;\n\t\t\t\tpointDisplayWriter(16, i32(angleh), vec3(0.9,0.9,0.9));\n\t\t\t\tpointDisplayWriter(17, i32(angled), vec3(0.9,0.9,0.9));\n\t\t\t\tpointDisplayWriter(18, i32(angleu), vec3(0.9,0.9,0.9));\n\t\t}\n\t\tif (GlobalVariables[0] == 2) {\n\t\t\t\t//player _ win!\n\t\t\t\tpointDisplayWriter(0, -16, vec3(r,g,b));\n\t\t\t\tpointDisplayWriter(1, -12, vec3(r,g,b));\n\t\t\t\tpointDisplayWriter(2, -1, vec3(r,g,b));\n\t\t\t\tpointDisplayWriter(3, -25, vec3(r,g,b));\n\t\t\t\tpointDisplayWriter(4, -5, vec3(r,g,b));\n\t\t\t\tpointDisplayWriter(5, -18, vec3(r,g,b));\n\n\t\t\t\tpointDisplayWriter(7, curPlayer+1, vec3(r,g,b));\n\n\t\t\t\tpointDisplayWriter(9, -23, vec3(r,g,b));\n\t\t\t\tpointDisplayWriter(10, -9, vec3(r,g,b));\n\t\t\t\tpointDisplayWriter(11, -14, vec3(r,g,b));\n\t\t\t\tpointDisplayWriter(12, 16, vec3(r,g,b));\n\t\t}\n}\n\n// Decodeur des caractères pour les afficheurs à points\nfn pointDisplayWriter(id : i32, car : i32, col : vec3<f32>){\n\t\tlet x = PointDisplayData[PDDAccess(0,id)];\n\t\tlet y = PointDisplayData[PDDAccess(1,id)];\n\t\t\n\t\tswitch car {\n\t\t\t\tdefault:{}\n\t\t\n\t\t\t\tcase -26: { //Z\n\t\t\t\t\t\tline(x, y, x+DISPLAYSIZEX, y, col);\n\t\t\t\t\t\tline(x, y+DISPLAYSIZEY, x+DISPLAYSIZEX, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x, y, x+DISPLAYSIZEX, y+DISPLAYSIZEY, col);\n\t\t\t\t}\n\n\t\t\t\tcase -25: { //Y\n\t\t\t\t\t\tline(x, y+DISPLAYSIZEY, x+DISPLAYSIZEX/2, y+DISPLAYSIZEY/2, col);\n\t\t\t\t\t\tline(x+DISPLAYSIZEX, y+DISPLAYSIZEY, x+DISPLAYSIZEX/2, y+DISPLAYSIZEY/2, col);\n\t\t\t\t\t\tline(x+DISPLAYSIZEX/2, y, x+DISPLAYSIZEX/2, y+DISPLAYSIZEY/2, col);\n\t\t\t\t}\n\n\t\t\t\tcase -24: { //X\n\t\t\t\t\t\tline(x, y+DISPLAYSIZEY, x+DISPLAYSIZEX, y, col);\n\t\t\t\t\t\tline(x, y, x+DISPLAYSIZEX, y+DISPLAYSIZEY, col);\n\t\t\t\t}\n\n\t\t\t\tcase -23: { //W\n\t\t\t\t\t\tline(x, y, x, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x+DISPLAYSIZEX, y, x+DISPLAYSIZEX, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x, y, x+DISPLAYSIZEX/2, y+DISPLAYSIZEY/2, col);\n\t\t\t\t\t\tline(x+DISPLAYSIZEX/2, y+DISPLAYSIZEY/2, x+DISPLAYSIZEX, y, col);\n\t\t\t\t}\n\n\t\t\t\tcase -22: { //V\n\t\t\t\t\t\tline(x, y+DISPLAYSIZEY/2, x, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x+DISPLAYSIZEX, y+DISPLAYSIZEY/2, x+DISPLAYSIZEX, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x+DISPLAYSIZEX/2, y, x+DISPLAYSIZEX, y+DISPLAYSIZEY/2, col);\n\t\t\t\t\t\tline(x, y+DISPLAYSIZEY/2, x+DISPLAYSIZEX/2, y, col);\n\t\t\t\t}\n\n\t\t\t\tcase -21: { //U\n\t\t\t\t\t\tline(x, y, x+DISPLAYSIZEX, y, col);\n\t\t\t\t\t\tline(x, y, x, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x+DISPLAYSIZEX, y, x+DISPLAYSIZEX, y+DISPLAYSIZEY, col);\n\t\t\t\t}\n\n\t\t\t\tcase -20: { //T\n\t\t\t\t\t\tline(x+DISPLAYSIZEX/2, y, x+DISPLAYSIZEX/2, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x, y+DISPLAYSIZEY, x+DISPLAYSIZEX, y+DISPLAYSIZEY, col);\n\t\t\t\t}\n\n\t\t\t\tcase -19: { //S\n\t\t\t\t\t\tline(x+DISPLAYSIZEX/2, y+DISPLAYSIZEY, x+DISPLAYSIZEX, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x, y+DISPLAYSIZEY/2, x+DISPLAYSIZEX, y+DISPLAYSIZEY/2, col);\n\t\t\t\t\t\tline(x, y, x+DISPLAYSIZEX/2, y, col);\n\t\t\t\t\t\tline(x+DISPLAYSIZEX/2, y, x+DISPLAYSIZEX, y+DISPLAYSIZEY/2, col);\n\t\t\t\t\t\tline(x, y+DISPLAYSIZEY/2, x+DISPLAYSIZEX/2, y+DISPLAYSIZEY, col);\n\t\t\t\t}\n\n\t\t\t\tcase -18: { //R\n\t\t\t\t\t\tline(x, y+DISPLAYSIZEY/2, x+DISPLAYSIZEX, y+DISPLAYSIZEY/2, col);\n\t\t\t\t\t\tline(x, y+DISPLAYSIZEY, x+DISPLAYSIZEX, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x, y, x, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x+DISPLAYSIZEX, y+DISPLAYSIZEY/2, x+DISPLAYSIZEX, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x,y+DISPLAYSIZEY/2, x+DISPLAYSIZEX, y, col); \n\t\t\t\t}\n\n\t\t\t\tcase -17: { //Q\n\t\t\t\t\t\tline(x, y, x+DISPLAYSIZEX, y, col);\n\t\t\t\t\t\tline(x, y, x, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x+DISPLAYSIZEX, y, x+DISPLAYSIZEX, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x, y+DISPLAYSIZEY, x+DISPLAYSIZEX, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x+DISPLAYSIZEX/2, y+DISPLAYSIZEY/2, x+DISPLAYSIZEX, y, col);\n\t\t\t\t}\n\n\t\t\t\tcase -16: { //P\n\t\t\t\t\t\tline(x, y+DISPLAYSIZEY/2, x+DISPLAYSIZEX, y+DISPLAYSIZEY/2, col);\n\t\t\t\t\t\tline(x, y+DISPLAYSIZEY, x+DISPLAYSIZEX, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x, y, x, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x+DISPLAYSIZEX, y+DISPLAYSIZEY/2, x+DISPLAYSIZEX, y+DISPLAYSIZEY, col);\n\t\t\t\t}\n\n\t\t\t\tcase -15: { //O\n\t\t\t\t\t\tline(x, y, x+DISPLAYSIZEX, y, col);\n\t\t\t\t\t\tline(x, y, x, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x+DISPLAYSIZEX, y, x+DISPLAYSIZEX, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x, y+DISPLAYSIZEY, x+DISPLAYSIZEX, y+DISPLAYSIZEY, col);\n\t\t\t\t}\n\n\t\t\t\tcase -14: { //N\n\t\t\t\t\t\tline(x, y, x, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x+DISPLAYSIZEX, y, x+DISPLAYSIZEX, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x, y+DISPLAYSIZEY, x+DISPLAYSIZEX, y, col);\n\t\t\t\t}\n\n\t\t\t\tcase -13: { //M\n\t\t\t\t\t\tline(x, y, x, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x+DISPLAYSIZEX, y, x+DISPLAYSIZEX, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x, y+DISPLAYSIZEY, x+DISPLAYSIZEX/2, y+DISPLAYSIZEY/2, col);\n\t\t\t\t\t\tline(x+DISPLAYSIZEX, y+DISPLAYSIZEY, x+DISPLAYSIZEX/2, y+DISPLAYSIZEY/2, col);\n\t\t\t\t}\n\n\t\t\t\tcase -12: { //L\n\t\t\t\t\t\tline(x, y, x, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x, y, x+DISPLAYSIZEX, y, col);\n\t\t\t\t}\t\t\t\n\n\t\t\t\tcase -11: { //K\n\t\t\t\t\t\tline(x, y, x, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x, y+DISPLAYSIZEY/2, x+DISPLAYSIZEX, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x, y+DISPLAYSIZEY/2, x+DISPLAYSIZEX, y, col);\n\t\t\t\t}\n\n\t\t\t\tcase -10: { //J\n\t\t\t\t\t\tline(x+DISPLAYSIZEX/2, y, x+DISPLAYSIZEX/2, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x, y, x+DISPLAYSIZEX/2, y, col);\n\t\t\t\t\t\tline(x, y+DISPLAYSIZEY, x+DISPLAYSIZEX, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x, y, x, y+DISPLAYSIZEY/2, col);\n\t\t\t\t}\n\n\t\t\t\tcase -9: {\t//I\n\t\t\t\t\t\tline(x+DISPLAYSIZEX/2, y, x+DISPLAYSIZEX/2, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x, y, x+DISPLAYSIZEX, y, col);\n\t\t\t\t\t\tline(x, y+DISPLAYSIZEY, x+DISPLAYSIZEX, y+DISPLAYSIZEY, col);\n\t\t\t\t}\n\n\t\t\t\tcase -8: { //H\n\t\t\t\t\t\tline(x, y+DISPLAYSIZEY/2, x+DISPLAYSIZEX, y+DISPLAYSIZEY/2, col);\n\t\t\t\t\t\tline(x, y, x, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x+DISPLAYSIZEX, y, x+DISPLAYSIZEX, y+DISPLAYSIZEY, col);\n\t\t\t\t}\n\n\t\t\t\tcase -7: { //G\n\t\t\t\t\t\tline(x, y, x+DISPLAYSIZEX, y, col);\n\t\t\t\t\t\tline(x, y, x, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x+DISPLAYSIZEX/2, y+DISPLAYSIZEY/2, x+DISPLAYSIZEX, y+DISPLAYSIZEY/2, col);\n\t\t\t\t\t\tline(x, y+DISPLAYSIZEY, x+DISPLAYSIZEX, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x+DISPLAYSIZEX, y, x+DISPLAYSIZEX, y+DISPLAYSIZEY/2, col);\n\t\t\t\t}\n\n\t\t\t\tcase -6: { //F\n\t\t\t\t\t\tline(x, y+DISPLAYSIZEY/2, x+DISPLAYSIZEX, y+DISPLAYSIZEY/2, col);\n\t\t\t\t\t\tline(x, y+DISPLAYSIZEY, x+DISPLAYSIZEX, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x, y, x, y+DISPLAYSIZEY, col);\n\t\t\t\t}\n\n\t\t\t\tcase -5: { //E\n\t\t\t\t\t\tline(x, y, x+DISPLAYSIZEX, y, col);\n\t\t\t\t\t\tline(x, y+DISPLAYSIZEY/2, x+DISPLAYSIZEX, y+DISPLAYSIZEY/2, col);\n\t\t\t\t\t\tline(x, y+DISPLAYSIZEY, x+DISPLAYSIZEX, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x, y, x, y+DISPLAYSIZEY, col);\n\t\t\t\t}\n\n\t\t\t\tcase -4: { //D\n\t\t\t\t\t\tline(x, y, x+DISPLAYSIZEX/2, y, col);\t\t\t\t\t\t\n\t\t\t\t\t\tline(x, y+DISPLAYSIZEY, x+DISPLAYSIZEX/2, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x, y, x, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x+DISPLAYSIZEX/2, y+DISPLAYSIZEY, x+DISPLAYSIZEX, y+DISPLAYSIZEY/2, col);\n\t\t\t\t\t\tline(x+DISPLAYSIZEX/2, y, x+DISPLAYSIZEX, y+DISPLAYSIZEY/2, col);\n\t\t\t\t}\n\n\t\t\t\tcase -3: { //C\n\t\t\t\t\t\tline(x+DISPLAYSIZEX/2, y, x+DISPLAYSIZEX, y, col);\n\t\t\t\t\t\tline(x+DISPLAYSIZEX/2, y+DISPLAYSIZEY, x+DISPLAYSIZEX, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x, y+DISPLAYSIZEY/2, x+DISPLAYSIZEX/2, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x, y+DISPLAYSIZEY/2, x+DISPLAYSIZEX/2, y, col);\n\t\t\t\t}\n\n\t\t\t\tcase -2: { //B\n\t\t\t\t\t\tline(x, y, x+DISPLAYSIZEX/2, y, col);\n\t\t\t\t\t\tline(x, y+DISPLAYSIZEY, x+DISPLAYSIZEX/2, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x, y, x, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x, y+DISPLAYSIZEY/2, x+DISPLAYSIZEX, y+DISPLAYSIZEY/2, col);\n\t\t\t\t\t\tline(x+DISPLAYSIZEX/2, y+DISPLAYSIZEY, x+DISPLAYSIZEX, y+DISPLAYSIZEY/2, col);\n\t\t\t\t\t\tline(x+DISPLAYSIZEX/2, y, x+DISPLAYSIZEX, y+DISPLAYSIZEY/2, col);\n\t\t\t\t}\n\n\t\t\t\tcase -1: { //A\n\t\t\t\t\t\tline(x, y+DISPLAYSIZEY/2, x+DISPLAYSIZEX, y+DISPLAYSIZEY/2, col);\n\t\t\t\t\t\tline(x, y, x, y+DISPLAYSIZEY/2, col);\n\t\t\t\t\t\tline(x+DISPLAYSIZEX, y, x+DISPLAYSIZEX, y+DISPLAYSIZEY/2, col);\n\t\t\t\t\t\tline(x, y+DISPLAYSIZEY/2, x+DISPLAYSIZEX/2, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x+DISPLAYSIZEX, y+DISPLAYSIZEY/2, x+DISPLAYSIZEX/2, y+DISPLAYSIZEY, col);\n\t\t\t\t}\n\n\t\t\t\tcase 0: { //0\n\t\t\t\t\t\tline(x, y, x+DISPLAYSIZEX, y, col);\n\t\t\t\t\t\tline(x, y, x, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x+DISPLAYSIZEX, y, x+DISPLAYSIZEX, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x, y+DISPLAYSIZEY, x+DISPLAYSIZEX, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x, y, x+DISPLAYSIZEX, y+DISPLAYSIZEY, col);\n\t\t\t\t}\n\n\t\t\t\tcase 1: { //1\n\t\t\t\t\t\tline(x+DISPLAYSIZEX/2, y, x+DISPLAYSIZEX/2, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x, y+DISPLAYSIZEY/2, x+DISPLAYSIZEX/2, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x, y, x+DISPLAYSIZEX, y, col);\n\t\t\t\t}\n\t\t\t\t\n\t\t\t\tcase 2: { //2\n\t\t\t\t\t\tline(x, y, x+DISPLAYSIZEX, y, col);\n\t\t\t\t\t\tline(x, y+DISPLAYSIZEY/2, x+DISPLAYSIZEX, y+DISPLAYSIZEY/2, col);\n\t\t\t\t\t\tline(x, y+DISPLAYSIZEY, x+DISPLAYSIZEX, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x, y, x, y+DISPLAYSIZEY/2, col);\n\t\t\t\t\t\tline(x+DISPLAYSIZEX, y+DISPLAYSIZEY/2, x+DISPLAYSIZEX, y+DISPLAYSIZEY, col);\n\t\t\t\t}\n\n\t\t\t\tcase 3: { //3\n\t\t\t\t\t\tline(x, y, x+DISPLAYSIZEX, y, col);\n\t\t\t\t\t\tline(x, y+DISPLAYSIZEY/2, x+DISPLAYSIZEX, y+DISPLAYSIZEY/2, col);\n\t\t\t\t\t\tline(x, y+DISPLAYSIZEY, x+DISPLAYSIZEX, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x+DISPLAYSIZEX, y, x+DISPLAYSIZEX, y+DISPLAYSIZEY, col);\n\t\t\t\t}\n\t\t\t\t\n\t\t\t\tcase 4: { //4\n\t\t\t\t\t\t\tline(x, y+DISPLAYSIZEY/2, x+DISPLAYSIZEX, y+DISPLAYSIZEY/2, col);\n\t\t\t\t\t\t\tline(x+DISPLAYSIZEX, y, x+DISPLAYSIZEX, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\t\tline(x, y+DISPLAYSIZEY/2, x, y+DISPLAYSIZEY, col);\n\t\t\t\t}\n\t\t\t\t\n\t\t\t\tcase 5: { //5\n\t\t\t\t\t\tline(x, y, x+DISPLAYSIZEX, y, col);\n\t\t\t\t\t\tline(x, y+DISPLAYSIZEY/2, x+DISPLAYSIZEX, y+DISPLAYSIZEY/2, col);\n\t\t\t\t\t\tline(x, y+DISPLAYSIZEY, x+DISPLAYSIZEX, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x+DISPLAYSIZEX, y, x+DISPLAYSIZEX, y+DISPLAYSIZEY/2, col);\n\t\t\t\t\t\tline(x, y+DISPLAYSIZEY/2, x, y+DISPLAYSIZEY, col);\n\t\t\t\t}\n\n\t\t\t\tcase 6: { //6\n\t\t\t\t\t\tline(x, y, x+DISPLAYSIZEX, y, col);\n\t\t\t\t\t\tline(x, y, x, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x, y+DISPLAYSIZEY/2, x+DISPLAYSIZEX, y+DISPLAYSIZEY/2, col);\n\t\t\t\t\t\tline(x, y+DISPLAYSIZEY, x+DISPLAYSIZEX, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x+DISPLAYSIZEX, y, x+DISPLAYSIZEX, y+DISPLAYSIZEY/2, col);\n\t\t\t\t}\n\n\t\t\t\tcase 7: { //7\n\t\t\t\t\t\tline(x, y+DISPLAYSIZEY, x+DISPLAYSIZEX, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x+DISPLAYSIZEX, y, x+DISPLAYSIZEX, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x+DISPLAYSIZEX/2, y+DISPLAYSIZEY/2, x+DISPLAYSIZEX, y+DISPLAYSIZEY/2, col);\n\t\t\t\t}\n\n\t\t\t\tcase 8: { //8\n\t\t\t\t\t\tline(x, y, x+DISPLAYSIZEX, y, col);\n\t\t\t\t\t\tline(x, y+DISPLAYSIZEY, x+DISPLAYSIZEX, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x, y+DISPLAYSIZEY/2, x+DISPLAYSIZEX, y+DISPLAYSIZEY/2, col);\n\t\t\t\t\t\tline(x+DISPLAYSIZEX, y, x+DISPLAYSIZEX, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x, y, x, y+DISPLAYSIZEY, col);\n\t\t\t\t}\n\n\t\t\t\tcase 9: { //9\n\t\t\t\t\t\tline(x, y, x+DISPLAYSIZEX, y, col);\n\t\t\t\t\t\tline(x, y+DISPLAYSIZEY, x+DISPLAYSIZEX, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x, y+DISPLAYSIZEY/2, x+DISPLAYSIZEX, y+DISPLAYSIZEY/2, col);\n\t\t\t\t\t\tline(x+DISPLAYSIZEX, y, x+DISPLAYSIZEX, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\tline(x, y+DISPLAYSIZEY/2, x, y+DISPLAYSIZEY, col);\n\t\t\t\t}\n\n\t\t\t\tcase 10: { //space\n\t\t\t\t}\n\t\t\t\t\n\t\t\t\tcase 11: { //>\n\t\t\t\t\t\t\tline(x, y, x+DISPLAYSIZEX, y+DISPLAYSIZEY/2, col);\n\t\t\t\t\t\t\tline(x, y+DISPLAYSIZEY, x+DISPLAYSIZEX, y+DISPLAYSIZEY/2, col);\n\t\t\t\t}\n\n\t\t\t\tcase 12: { //<\n\t\t\t\t\t\t\tline(x+DISPLAYSIZEX, y, x, y+DISPLAYSIZEY/2, col);\n\t\t\t\t\t\t\tline(x+DISPLAYSIZEX, y+DISPLAYSIZEY, x, y+DISPLAYSIZEY/2, col);\n\t\t\t\t}\n\t\t\t\t\n\t\t\t\tcase 13: { //up arrow\n\t\t\t\t\t\t\tline(x, y, x+DISPLAYSIZEX/2, y+DISPLAYSIZEY, col);\n\t\t\t\t\t\t\tline(x+DISPLAYSIZEX, y, x+DISPLAYSIZEX/2, y+DISPLAYSIZEY, col);\n\t\t\t\t}\n\t\t\t\n\t\t\t\tcase 14: { //down arrow\n\t\t\t\t\t\t\tline(x, y+DISPLAYSIZEY, x+DISPLAYSIZEX/2, y, col);\n\t\t\t\t\t\t  line(x+DISPLAYSIZEX, y+DISPLAYSIZEY, x+DISPLAYSIZEX/2, y, col);\n\t\t\t\t}\n\n\t\t\t\tcase 15: { //:\n\t\t\t\t\t\t  line(x, y, x, y, col);\n\t\t\t\t\t\t\tline(x, y+DISPLAYSIZEY/2, x, y+DISPLAYSIZEY/2, col);\n\t\t\t\t}\n\t\t\t\t\n\t\t\t\tcase 16: { //!\n\t\t\t\t\t\t\tline(x, y, x, y, col);\n\t\t\t\t\t\t\tline(x, y+DISPLAYSIZEY/2, x, y+DISPLAYSIZEY, col);\n\t\t\t\t}\n\t\t\t\tcase 17: { // /\n\t\t\t\t\t\t\tline(x, y, x+DISPLAYSIZEX, y+DISPLAYSIZEY, col);\n\t\t\t\t}\n\t\t}\n}",
      "bufferIds": [
        "tex-default",
        "5abcbbd6-9df6-4fe4-ab14-a51f994e8dd6",
