  "shaders": [
    {
      "id": "4b21c4f4-130f-4927-8494-5e3fd1e4df9c",
      "name": "Init",
      "workgroup": {
        "x": 8,
        "y": 8,
        "z": 1
      },
      "code": "@compute @workgroup_size(SIZEWORKX, SIZEWORKY, 1)\nfn Init(@builtin(global_invocation_id) gid : vec3<u32>) {\n\t\tif (GlobalVariables[0] == 0 || step == 0){\n\t\t\t\tif (GAMETYPE==1){\n\t\t\t\t\t\tcurveInit();\n\t\t\t\t}\n\t\t\t\tif (gid.x == 0 && gid.y == 0){\n\t\t\t\t\t\tcurveReset();\n\t\t\t\t\t\tterrainMatrixReset(gid);\n\t\t\t\t\t\tterrainDataReset();\n\t\t\t\t\t\tpointDisplayInit();\n\t\t\t\t}\n\t\t\t\tcurveMatrixInit(gid);\n\t\t\t\tterrainInit();\n\t\t\t\tterrainFill(gid);\n\t\t\t\t\n\t\t\t\tplayerInit();\n\t\t\t\tGlobalVariables[4] = TIMERTIME*20;\n\n\t\t\t\tif (gid.x == SIZEX-1 && gid.y == SIZEY-1) { GlobalVariables[0] = 1; }\n\t\t}\n\t\tif (i32(step) == GlobalVariables[1]+2 ){ grassInit(gid); }\n}\n\nfn terrainDataReset() { \n\t\tfor (var i : i32 = 0; i < NBTERRAINPOINT; i++) {\n\t\t\t\tTerrainData[TDAccess(0,i)] = 0;\n\t\t\t\tTerrainData[TDAccess(1,i)] = 0;\n\t\t}\n}\n\nfn terrainMatrixReset(gid : vec3<u32>){ TerrainMatrix[TMAccess(i32(gid.x),i32(gid.y))] = 0; }\n\nfn curveReset() {\n\t\tvar y : i32 = 0;\n\t\tfor (var i : i32 = 0; i < NBCURVE; i++) {\n\t\t\t\tfor (var j : i32 = 0; j < NBPARAMCURVE; j++) {\n\t\t\t\t\t\tCurveData[CDAccess(j,i)] = 0;\n\t\t\t\t}\n\t\t}\n} \n\nfn curveInit() {\n\t\t//origine x, origine y, angle, velocité, r, g, b, temps de départ, état (à 0 de base, non réglable),  \n\t\t// collision x ( à -1 de base, non réglable), collision y ( à -1 de base, non réglable), step de l'explosion ( à -1 de base, non réglable)\n\n\t\tfor (var i : i32 = 0; i < NBCURVE; i++){\n\t\t\t\tCurveData[CDAccess(0,i)] = SIZEX/2;\n\t\t\t\tCurveData[CDAccess(1,i)] = SIZEY/2;\n\t\t\t\tCurveData[CDAccess(2,i)] = radians(f32(i*(360/NBCURVE)));\n\t\t\t\tCurveData[CDAccess(3,i)] = 55;\n\n\t\t\t\tCurveData[CDAccess(4,i)] = 0.99;\n\t\t\t\tCurveData[CDAccess(5,i)] = 0.99;\n\t\t\t\tCurveData[CDAccess(6,i)] = 0.99;\n\n\t\t\t\tCurveData[CDAccess(7,i)] = f32(i) +  f32(step);\n\t\t\t\tCurveData[CDAccess(8,i)] = 1;\n\n\t\t\t\tCurveData[CDAccess(9,i)] = -1;\n\t\t\t\tCurveData[CDAccess(10,i)] = -1;\n\t\t\t\tCurveData[CDAccess(11,i)] = -1;\n\t\t}\n}\n\nfn curveMatrixInit(gid : vec3<u32>){ CurveMatrix[CMAccess(i32(gid.x),i32(gid.y))] = vec4(0.0, 0.0, 0.0 ,0.0); }\n\nfn terrainInit() {\n\t\tfor (var i : i32 = 0; i < NBTERRAINPOINT; i++){\n\t\t\t\tTerrainData[TDAccess(0,i)] = ((SIZEX/(NBTERRAINPOINT-1))*i);\n\t\t\t\tTerrainData[TDAccess(1,i)] =\ti32( alea(u32(i), step%(SIZEY),Random[0] )%(SIZEY-4) )/2;\n\t\t}\n}\n\nfn terrainFill(gid : vec3<u32>) {\n\t\tvar terrainSeg : i32 = i32(floor( f32(i32(gid.x-1)/( SIZEX/(NBTERRAINPOINT-1) )) ));\n\t\tvar x1 = TerrainData[TDAccess(0,terrainSeg)];\n\t\tvar x2 = TerrainData[TDAccess(0,terrainSeg+1)];\n\t\tvar y1 =  TerrainData[TDAccess(1,terrainSeg)];\n\t\tvar y2 =  TerrainData[TDAccess(1,terrainSeg+1)];\n\n\t\tvar xp = 0;\n\t\tif (i32(gid.x) <= TerrainData[TDAccess(0,NBTERRAINPOINT-1)]){\n\t\t\t\txp = crossProduct(x1, x2, i32(gid.x), y1, y2 ,i32(gid.y));\n\t\t}else{\n\t\t\t\txp = crossProduct(x2, TerrainData[TDAccess(0,NBTERRAINPOINT-1)], i32(gid.x), y2, y2 ,i32(gid.y));\n\t\t}\n\n\t\tif (xp < 0){ TerrainMatrix[TMAccess(i32(gid.x),i32(gid.y))] = 2; }\n\t\telse{ TerrainMatrix[TMAccess(i32(gid.x),i32(gid.y))] = 0; }\n}\n\nfn grassInit(gid : vec3<u32>){\n\t\tif(gid.y < SIZEY/2){\n\t\t\t\tif (TerrainMatrix[TMAccess(i32(gid.x),i32(gid.y+2))] != 2 && TerrainMatrix[TMAccess(i32(gid.x),i32(gid.y))] == 2) { TerrainMatrix[TMAccess(i32(gid.x),i32(gid.y))] = 1; }\n\t\t\t\tif (gid.x > 1 && TerrainMatrix[TMAccess(i32(gid.x-1),i32(gid.y))] != 2 && TerrainMatrix[TMAccess(i32(gid.x),i32(gid.y))] == 2) { TerrainMatrix[TMAccess(i32(gid.x),i32(gid.y))] = 1; }\n\t\t\t\tif (gid.x < (SIZEX-1) && TerrainMatrix[TMAccess(i32(gid.x+1),i32(gid.y))] != 2 && TerrainMatrix[TMAccess(i32(gid.x),i32(gid.y))] == 2) { TerrainMatrix[TMAccess(i32(gid.x),i32(gid.y))] = 1; }\n\t\t}\n}\n\nfn playerInit(){\n\t\tPlayerData[PDAccess(0,0)] = (SIZEX/NBTERRAINPOINT)/2;\n\t\tPlayerData[PDAccess(1,0)] = SIZEY/2;\n\t\tPlayerData[PDAccess(2,0)] = PlayerData[PDAccess(0,0)];\n\t\tPlayerData[PDAccess(3,0)] = PlayerData[PDAccess(1,0)];\n\t\tPlayerData[PDAccess(4,0)] = 0;\n\t\tPlayerData[PDAccess(5,0)] = 45;\n\t\tPlayerData[PDAccess(6,0)] = 50;\n\t\tPlayerData[PDAccess(7,0)] = 0.99;\n\t\tPlayerData[PDAccess(8,0)] = 0.0;\n\t\tPlayerData[PDAccess(9,0)] = 0.0;\n\t\tPlayerData[PDAccess(10,0)] = 999;\n\n\t\tPlayerData[PDAccess(0,1)] = SIZEX-(SIZEX/NBTERRAINPOINT)/2;\n\t\tPlayerData[PDAccess(1,1)] = SIZEY/2;\n\t\tPlayerData[PDAccess(2,1)] = PlayerData[PDAccess(0,1)];\n\t\tPlayerData[PDAccess(3,1)] = PlayerData[PDAccess(1,1)];\n\t\tPlayerData[PDAccess(4,1)] = 0;\n\t\tPlayerData[PDAccess(5,1)] = 135;\n\t\tPlayerData[PDAccess(6,1)] = 50;\n\t\tPlayerData[PDAccess(7,1)] = 0.0;\n\t\tPlayerData[PDAccess(8,1)] = 0.0;\n\t\tPlayerData[PDAccess(9,1)] = 0.99;\n\t\tPlayerData[PDAccess(10,1)] = 999;\n}\n\nfn pointDisplayInit(){\n\t\tlet nbPointDisplayI32 : i32 = i32(NBPOINTDISPLAY);\n\t\tfor (var i : i32 = 0; i < nbPointDisplayI32 ; i++){\n\t\t\t\tfor (var j : i32 = 0; j < NBPOINTDISPLAYLINE; j++){\n\t\t\t\t\t\tPointDisplayMatrix[PDMAccess(0,i+(j*nbPointDisplayI32 ))] = (i*(DISPLAYSIZEX+2))+1;\n\t\t\t\t\t\tPointDisplayMatrix[PDMAccess(1,i+(j*nbPointDisplayI32 ))] = (SIZEY-1) - ((j*(DISPLAYSIZEY+2))+(DISPLAYSIZEY+2));\n\t\t\t\t}\n\t\t}\n}",
      "bufferIds": [
        "0ce96281-8c6f-4830-bd4e-937144a403c2",
        "dbc28fe0-edba-491d-abfe-fe5fb2f32c2f",
        "acab4bac-da45-4303-88be-f23b8db35de3",
        "5abcbbd6-9df6-4fe4-ab14-a51f994e8dd6",
        "d4138b69-1b0f-45cd-884b-f0d79be199a9",
        "9da514be-68f4-44ce-8ec4-ffcaa0093fad",
        "5d64e419-9907-4441-bdd6-0a86d8eb0ba0",
        "94f0ffab-9911-4533-a628-b34c0da715c7"
      ]
    },
    {
      "id": "efcd35c5-52fe-4ffa-af63-6cde3893f240",
      "name": "DisplayHandler",
      "workgroup": {
        "x": 8,
        "y": 8,
        "z": 1
      },
      "code": "@compute @workgroup_size(SIZEWORKX, SIZEWORKY, 1)\nfn DisplayHandler(@builtin(global_invocation_id) gid : vec3<u32>) {\n\t\tif (GlobalVariables[0] != 0 && i32(step) > GlobalVariables[0]+2) {\n\t\t\t\treset(gid);\n\t\t\t\tcurveDisplay(gid);\n\t\t\t\tterrainDisplay(gid);\n\t\t\t\tplayerDisplay(gid);\n\t\t\t\texplosionDisplay(gid,8);\n\t\t\t\ttimerDisplay();\n\t\t\t\tif (gid.x == SIZEX-1 && gid.y == SIZEY-1) { pointDisplayDisplay();}\n\t\t}\n}\n\nfn reset(gid : vec3<u32>){ Display[gid.y * SIZEX + gid.x] = vec3(0.0, 0.0, 0.0); } \n\nfn playerDisplay(gid : vec3<u32>){\n\t\tfor (var i : i32 = 0; i < NBPLAYER; i++) {\n\t\t\t\tlet life = PlayerData[PDAccess(10,i)];\n\t\t\t\tif (life > 0) {\n\t\t\t\t\t\tlet x = PlayerData[PDAccess(0,i)];\n\t\t\t\t\t\tlet y = PlayerData[PDAccess(1,i)];\n\t\t\t\t\t\tlet angle = PlayerData[PDAccess(5,i)];\n\t\t\t\t\t\t\n\t\t\t\t\t\tlet life = PlayerData[PDAccess(10,i)]; \t\t\t\t\t\t\n\n\t\t\t\t\t\tlet r = PlayerData[PDAccess(7,i)]*(0.5 + life/1998);\n\t\t\t\t\t\tlet g = PlayerData[PDAccess(8,i)]*(0.5 + life/1998);\n\t\t\t\t\t\tlet b = PlayerData[PDAccess(9,i)]*(0.5 + life/1998);\n\n\t\t\t\t\t\tlet xd = f32(gid.x) - x;\n\t\t\t\t\t\tlet yd = f32(gid.y) - y;\n\t\t\t\t\t\tlet d = sqrt(xd*xd + yd*yd);\n\n\t\t\t\t\t\tif (d < 4){\t\n\t\t\t\t\t\t\t\tDisplay[gid.y * SIZEX + gid.x] = vec3(r,g,b); \n\t\t\t\t\t\t}\n\t\t\t\t\t\tif (i32(x+cos(radians(angle))*8) > 0 && i32(x+cos(radians(angle))*8) < SIZEX) { line(i32(x), i32(y), i32(x+cos(radians(angle))*8), i32(y+sin(radians(angle))*8), vec3(r,g,b)); }\n\t\t\t\t}\n\t\t}\n}\n\nfn line(x0 : i32, y0 : i32, x1 : i32, y1 : i32, col : vec3<f32>){\n\t\tvar locX0 = x0;\n\t\tvar locX1 = x1;\n\t\tvar locY0 = y0;\n\t\tvar locY1 = y1;\n\t\tvar steep = false;\n\n\t\tif (abs(locX0-locX1) < abs(locY0-locY1)) {\n\t\t\t\tvar temp = locX0;\n\t\t\t\tlocX0 = locY0;\n\t\t\t\tlocY0 = temp;\n\n\t\t\t\ttemp = locX1;\n\t\t\t\tlocX1 = locY1;\n\t\t\t\tlocY1 = temp;\n\n\t\t\t\tsteep = true;\n\t\t}\n\n\t\tif(locX0 > locX1){\n\t\t\t\tvar temp = locX0;\n\t\t\t\tlocX0 = locX1;\n\t\t\t\tlocX1 = temp;\n\n\t\t\t\ttemp = locY0;\n\t\t\t\tlocY0 = locY1;\n\t\t\t\tlocY1 = temp;\n\t\t}\n\n\t\tlet dx : i32 = locX1 - locX0;\n\t\tlet dy : i32 = locY1 - locY0;\n\t\tlet derror : f32 = abs(f32(dy)/f32(dx));\t\n\t\tvar error : f32 = 0;\n\t\tvar y : i32 = locY0;\n\n\t\tfor (var x : i32 = locX0; x <= locX1; x++) {\n\t\t\t\tif (steep) { Display[x*SIZEX + y] = col; }\n\t\t\t\telse { Display[y*SIZEX + x] = col; }\n\n\t\t\t\terror += derror;\n\t\t\t\tif (error > 0.5) {\n\t\t\t\t\t\tif (locY1 > locY0){ y += 1; }\n\t\t\t\t\t\telse{ y -= 1; }\n\t\t\t\t\t\terror -= 1.0;\n\t\t\t\t}\n\t\t}\n}\n\nfn curveDisplay(gid : vec3<u32>) {\n\t\tif (CurveMatrix[gid.y*SIZEX + gid.x][0] != 0.0 || CurveMatrix[gid.y*SIZEX + gid.x][1] != 0.0 || CurveMatrix[gid.y*SIZEX + gid.x][2] != 0.0) {\n\t\t\t\tfor (var i : i32 = 0; i < 3; i++) { \n\t\t\t\t\t\tlet curStep = f32(step) - CurveMatrix[gid.y*SIZEX + gid.x][3] ;\n\t\t\t\t\t\tif (curStep < 4) { Display[gid.y*SIZEX + gid.x][i] = CurveMatrix[gid.y*SIZEX + gid.x][i] / pow(2,curStep-1); }\n\t\t\t\t\t\telse {  Display[gid.y*SIZEX + gid.x] = vec3(0.0, 0.0, 0.0); }\n\t\t\t\t}\n\t\t}\n}\n\nfn explosionDisplay(gid : vec3<u32>, explosionSize : i32) {\n\t\tfor (var i :i32 = 0; i < NBCURVE; i++){\n\t\t\t\tif (CurveData[CDAccess(8,i)] == 3){\n\t\t\t\t\t\tlet x = CurveData[CDAccess(9,i)];\n\t\t\t\t\t\tlet y = CurveData[CDAccess(10,i)];\n\t\t\t\t\t\tlet curStep = f32(step) - CurveData[CDAccess(11,i)];\n\t\t\t\t\t\tlet explosionSize = CurveData[CDAccess(12,i)];\n\t\n\t\t\t\t\t\tlet r : f32 = CurveData[CDAccess(4,i)];\n\t\t\t\t\t\tlet g : f32 = CurveData[CDAccess(5,i)];\n\t\t\t\t\t\tlet b : f32 = CurveData[CDAccess(6,i)];\n\t\t\t\t\t\tlet col : vec3<f32> = vec3(r,g,b);\n\n\t\t\t\t\t\tlet xd = f32(gid.x) - x;\n\t\t\t\t\t\tlet yd = f32(gid.y) - y;\n\t\t\t\t\t\tlet d = sqrt(xd*xd + yd*yd);\n\n\t\t\t\t\t\tif (curStep > 0 && curStep < NBFADEFRAME+1){\n\t\t\t\t\t\t\t\tif (d < f32(explosionSize)){\t\n\t\t\t\t\t\t\t\t\t\tDisplay[gid.y * SIZEX + gid.x] = col; \n\t\t\t\t\t\t\t\t\t\tTerrainMatrix[TMAccess(i32(gid.x), i32(gid.y))] = 0;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t\tif (curStep > 0 && curStep < NBFADEFRAME+1){\n\t\t\t\t\t\t\t\tif( d < f32(explosionSize/NBFADEFRAME)*curStep ){ Display[gid.y * SIZEX + gid.x] = vec3(0.0, 0.0, 0.0); }\n\t\t\t\t\t\t}\n\t\t\t\t}\n\t\t}\n}\n\nfn terrainDisplay(gid : vec3<u32>) {\n\t\tif (TerrainMatrix[TMAccess(i32(gid.x), i32(gid.y))] == 1) { Display[gid.y * SIZEX + gid.x] = vec3(0.0, 0.5, 0.0); }\n\t\tif (TerrainMatrix[TMAccess(i32(gid.x), i32(gid.y))] == 2) { \n\t\t\t\tif ( ((gid.x/4)+(gid.y/4))%2 == 0){ Display[gid.y * SIZEX + gid.x] = vec3(0.3, 0.1, 0.1); }\n\t\t\t\telse { Display[gid.y * SIZEX + gid.x] = vec3(0.15, 0.05, 0.05); }\n\t\t}\n}\n\nfn timerDisplay() {\n\t\tlet curPlayer = GlobalVariables[2];\n\n\t\tlet r = PlayerData[PDAccess(7,curPlayer)];\n\t\tlet g = PlayerData[PDAccess(8,curPlayer)];\n\t\tlet b = PlayerData[PDAccess(9,curPlayer)];\n\n\t\tlet x = ((GlobalVariables[4]/TIMERTIME)*(SIZEX/TIMERTIME))/2;\n\t\tlet y = SIZEY - ((DISPLAYSIZEY+2)*NBPOINTDISPLAYLINE)-3;\n\n\t\tline(0, y, x, y, vec3(r,g,b));\n}\n\nfn pointDisplayDisplay() {\n\t\t/*if (GAMETYPE == 1){\n\t\t\t\tlet curPlayer = GlobalVariables[2];\n\n\t\t\t\tfor (var i = -26; i < 18; i++){\t\n\t\t\t\t\t\tpointDisplayWriter(i+26, i, vec3(0.9,0.9,0.9));\n\t\t\t\t}\n\t\t\t\t// x\n\t\t\t\tpointDisplayWriter(i32(NBPOINTDISPLAY*1)+0, -24, vec3(0.9,0.9,0.9));\n\t\t\t\tpointDisplayWriter(i32(NBPOINTDISPLAY*1)+1, 15, vec3(0.9,0.9,0.9));\n\t\t\t\n\t\t\t\tvar px = PlayerData[PDAccess(0,curPlayer)];\n\t\t\t\tvar pxh = (px/100)%10;\n\t\t\t\tvar pxd = (px/10)%10;\n\t\t\t\tvar pxu = px%10;\n\t\t\t\tpointDisplayWriter(i32(NBPOINTDISPLAY*1)+2, i32(pxh), vec3(0.9,0.9,0.9));\n\t\t\t\tpointDisplayWriter(i32(NBPOINTDISPLAY*1)+3, i32(pxd), vec3(0.9,0.9,0.9));\n\t\t\t\tpointDisplayWriter(i32(NBPOINTDISPLAY*1)+4, i32(pxu), vec3(0.9,0.9,0.9));\n\n\t\t\t\tpointDisplayWriter(i32(NBPO