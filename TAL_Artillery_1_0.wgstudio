      "id": "ece0e9f4-4d42-4749-9af4-3de5c113a438",
      "name": "CalculHandler",
      "workgroup": {
        "x": 8,
        "y": 8,
        "z": 1
      },
      "code": "@compute @workgroup_size(8, 8, 1)\nfn CalculHandler(@builtin(global_invocation_id) gid : vec3<u32>) {\n\t\tif (GlobalVariables[0] != 0 && i32(step) > GlobalVariables[0]+2) {\n\t\t\t\tif (gid.x == 0 && gid.y == 0 && GlobalVariables[0] != 2) { timerHandler(); }\n\t\t\t\tcurveCalc(gid);\n\t\t\t\tterrainPhysic(gid);\n\t\t\t\tdamageCalc(gid);\n\t\t}\n}\n\nfn timerHandler() {\n\t\tlet time =  GlobalVariables[4];\n\t\tif (time > 0) { GlobalVariables[4] -=1; }\n\t\tif (time == 0) { \n\t\t\t\tGlobalVariables[2] = (GlobalVariables[2]+1)%NBPLAYER;\n\t\t\t\tGlobalVariables[4] = TIMERTIME*20;\n\t\t\t\tGlobalVariables[5] = i32( alea(step%(SIZEX), step%(SIZEY),Random[0])%21 )- 10;\n\t\t}\n}\n\nfn damageCalc(gid : vec3<u32>){\n\t\tfor (var c : i32 = 0; c < NBCURVE; c++){\n\t\t\t\tif (CurveData[CDAccess(8,c)] == 3){\n\t\t\t\t\t\tlet xExp = CurveData[CDAccess(9,c)];\n\t\t\t\t\t\tlet yExp = CurveData[CDAccess(10,c)];\n\t\t\t\t\t\tlet curStep = f32(step) - CurveData[CDAccess(11,c)];\n\t\t\t\t\t\tlet explosionSize = CurveData[CDAccess(12,c)];\n\n\t\t\t\t\t\tif (curStep > 0 && curStep < NBFADEFRAME+1){\n\t\t\t\t\t\t\t\tfor (var p : i32 = 0; p < NBPLAYER; p++){\n\t\t\t\t\t\t\t\t\t\tlet xPla = PlayerData[PDAccess(0,p)];\n\t\t\t\t\t\t\t\t\t\tlet yPla = PlayerData[PDAccess(1,p)];\n\n\t\t\t\t\t\t\t\t\t\tlet xd = xPla - xExp;\n\t\t\t\t\t\t\t\t\t\tlet yd = yPla - yExp;\n\t\t\t\t\t\t\t\t\t\tlet d = sqrt(xd*xd + yd*yd);\n\t\n\t\t\t\t\t\t\t\t\t\tif (d < f32(explosionSize)){ \n\t\t\t\t\t\t\t\t\t\t\t\tif (gid.x == 0 && gid.y == 0){ PlayerData[PDAccess(10,p)] -= 500 - (d * (500/f32(explosionSize))); }\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t}\n\t\t}\n}\n\nfn curveCalc(gid : vec3<u32>) {\n\t\tfor (var i :i32 = 0; i < NBCURVE; i++){\n\t\t\t\t//curveUpdate(i);\n\n\t\t\t\tvar x0 : i32 = i32(CurveData[CDAccess(0,i)]);\n\t\t\t\tvar y0 : i32 = i32(CurveData[CDAccess(1,i)]);\n\t\t\t\tvar angle : f32 = CurveData[CDAccess(2,i)];\n\t\t\t\tvar velocity : u32 = u32(CurveData[CDAccess(3,i)]);\n\n\t\t\t\tvar r : f32 = CurveData[CDAccess(4,i)];\n\t\t\t\tvar g : f32 = CurveData[CDAccess(5,i)];\n\t\t\t\tvar b : f32 = CurveData[CDAccess(6,i)];\n\t\t\t\tvar col : vec3<f32> = vec3(r,g,b);\n\t\t\n\t\t\t\tvar start : u32 = u32(CurveData[CDAccess(7,i)]);\n\n\t\t\t\tvar collisionsCoord : vec2<i32> = vec2(-1, -1);\n\n\t\t\t\tlet curX = nextX(x0, velocity, angle, step - start);\n\t\t\t\tlet curY = nextY(y0, velocity, angle, step - start );\n\t\t\t\t\n\t\t\t\tif (step > start && CurveData[CDAccess(8,i)] == 1){\n\t\t\t\t\t\tCurveData[CDAccess(8,i)] = 2;\n\t\t\t\t}\n\t\t\t\tif (CurveData[CDAccess(8,i)] == 2){\n\t\t\t\t\t\tlet prevX1 = nextX(x0, velocity, angle,(step - start) - 1);\n\t\t\t\t\t\tlet prevY1 = nextY(y0, velocity, angle,(step - start) - 1);\n\t\t\t\t\t\tcollisionsCoord = curve(gid, prevX1, curX, prevY1, curY, col);\n\t\t\t\t}\n\t\t\t\t\n\t\t\t\tif (collisionsCoord.x != -1 && collisionsCoord.y != -1 && CurveData[CDAccess(8,i)] == 2){\n\t\t\t\t\t\tCurveData[CDAccess(8,i)] = 3;\n\t\t\t\t\t\tCurveData[CDAccess(9,i)] = f32(collisionsCoord.x);\n\t\t\t\t\t\tCurveData[CDAccess(10,i)] = f32(collisionsCoord.y);\n\t\t\t\t\t\tCurveData[CDAccess(11,i)] = f32(step);\n\t\t\t\t}\n\n\t\t\t\tif (TerrainMatrix[TMAccess(x0,y0)] != 0 && CurveData[CDAccess(8,i)] == 2){\n\t\t\t\t\t\tCurveData[CDAccess(8,i)] = 3;\n\t\t\t\t\t\tCurveData[CDAccess(9,i)] = f32(x0);\n\t\t\t\t\t\tCurveData[CDAccess(10,i)] = f32(y0);\n\t\t\t\t\t\tCurveData[CDAccess(11,i)] = f32(step);\n\t\t\t\t}\n\t\t}\n}\n\nfn curveUpdate(i : i32){\n\t\tCurveData[CDAccess(0,i)] = PlayerData[CDAccess(1,0)];\n\t\tCurveData[CDAccess(1,i)] = PlayerData[CDAccess(2,0)];\n}\n\nfn terrainPhysic(gid : vec3<u32>) {\n\t\tlet x = i32(gid.x);\n\t\tlet y = i32(gid.y);\n\t\tif (y > 0){\n\t\t\t\tif (TerrainMatrix[TMAccess(x,y)] == 1 && TerrainMatrix[TMAccess(x,y-1)] == 0){\n\t\t\t\t\t\t TerrainMatrix[TMAccess(x,y)] = 0;\n\t\t\t\t\t\t TerrainMatrix[TMAccess(x,y-1)] = 1;\n\t\t\t  }\n\t\t\t\tif (TerrainMatrix[TMAccess(x,y)] == 2 && TerrainMatrix[TMAccess(x,y-1)] == 0){\n\t\t\t\t\t\t TerrainMatrix[TMAccess(x,y)] = 0;\n\t\t\t\t\t\t TerrainMatrix[TMAccess(x,y-1)] = 2;\n\t\t\t  }\n\t\t}\n}\n\nfn curve(gid : vec3<u32>, x0 : i32, x1 : i32, y0 : i32, y1 : i32, col : vec3<f32>) -> vec2<i32>{\n    let dx = abs(x1 - x0);\n    let dy = abs(y1 - y0);\n    var sx = 0;\n    var sy = 0;\n    if (x0 < x1){ sx = 1; } else { sx = -1; }\n    if (y0 < y1){ sy = 1; } else { sy = -1; }\n    var err = dx - dy;\n    var x = x0;\n    var y = y0;\n    while (x != x1 && y != y1) {\n\t\t\t\tif (x > 0 && x < (SIZEX-1) && y > 0 && TerrainMatrix[TMAccess(x,y)] == 0){\n\t\t\t\t\t\tif ( y < (SIZEY-((DISPLAYSIZEY+2)*NBPOINTDISPLAYLINE)-3 )) { CurveMatrix[y*SIZEX + x] = vec4(col.x, col.y, col.z, f32(step)); } ;\n       \t\t  var e2 = 2 * err;\n        \t\tif (e2 > -dy) {\n           \t\t err -= dy;\n           \t\t x += sx;\n        \t\t}\n       \t\t if (e2 < dx) {\n            \t\terr += dx;\n            \t\ty += sy;\n         \t\t}\n\t\t\t\t}else{\n\t\t\t\t\t\tDisplay[y*SIZEX + x] = col;\n\t\t\t\t\t\treturn vec2(x, y);\n\t\t\t\t}\n     }\n\t\treturn vec2(-1,-1);\n}\n\nfn nextX(x0: i32, v0 : u32, angle : f32, t : u32) -> i32 {\n\t\treturn x0 + i32(f32(v0*t)*cos(angle));\n}\n\nfn nextY(y0 : i32, v0 : u32, angle : f32, t : u32) -> i32 {\n\treturn y0 + i32(f32(v0*t)*sin(angle) - 0.5*g*f32(t*t));\n}",
      "bufferIds": [
        "0ce96281-8c6f-4830-bd4e-937144a403c2",
        "dbc28fe0-edba-491d-abfe-fe5fb2f32c2f",
        "acab4bac-da45-4303-88be-f23b8db35de3",
        "5abcbbd6-9df6-4fe4-ab14-a51f994e8dd6",
        "9da514be-68f4-44ce-8ec4-ffcaa0093fad",
        "94f0ffab-9911-4533-a628-b34c0da715c7",
        "tex-default",
        "d4138b69-1b0f-45cd-884b-f0d79be199a9"
      ]
    },
    {
      "id": "847cd508-cbc5-4af3-ad26-b4f9598d5eed",
      "name": "PlayerHandler",
      "workgroup": {
        "x": 8,
        "y": 8,
        "z": 1
      },
      "code": "@compute @workgroup_size(8, 8, 1)\nfn PlayerHandler(@builtin(global_invocation_id) gid : vec3<u32>) {\n\t\tif (GlobalVariables[0] == 1 && i32(step) > GlobalVariables[0]+2) {\t\t\n\t\t\t\tunblock();\n\t\t\t\tinputMov(gid);\n\t\t\t\tinputCannon(gid);\n\t\t\t\tplayerPhysic();\n\t\t\t\ttargerPhysic();\n\t\t}\n\t\tdeathHandler();\n\n\t\tif (gid.x + gid.y == 0 && GlobalVariables[3] != 0) { GlobalVariables[3] -= 1; }\n\n\t\tif (GlobalVariables[0] == 2) {\n\t\t\t\tif (key == 0x60 && GlobalVariables[3] == 0){\n\t\t\t\t\tGlobalVariables[0] = 0;\n\t\t\t\t\tGlobalVariables[1] = i32(step);\n\t\t\t\t\tGlobalVariables[3] = 10;\n\t\t\t\t}\n\t\t}\n}\n\nfn deathHandler() {\n\t\tlet curPlayer = GlobalVariables[2];\n\n\t\tif (PlayerData[PDAccess(10,curPlayer)] <= 0) {\n\t\t\tGlobalVariables[4] = TIMERTIME*20;\n\n\t\t\tPlayerData[PDAccess(10,curPlayer)] = 0;\n\n\t\t\tCurveData[CDAccess(0,curPlayer*5)] = PlayerData[PDAccess(0,curPlayer)];\n\t\t\tCurveData[CDAccess(1,curPlayer*5)] = PlayerData[PDAccess(1,curPlayer)];\n\n\t\t\tCurveData[CDAccess(2,curPlayer*5)] = 0;\n\t\t\tCurveData[CDAccess(3,curPlayer*5)] = 1;\n\n\t\t\tCurveData[CDAccess(4,curPlayer*5)] = PlayerData[PDAccess(7,curPlayer)];\n\t\t\tCurveData[CDAccess(5,curPlayer*5)] = PlayerData[PDAccess(8,curPlayer)];\n\t\t\tCurveData[CDAccess(6,curPlayer*5)] = PlayerData[PDAccess(9,curPlayer)];\n\n\t\t\tCurveData[CDAccess(7,curPlayer*5)] = f32(step);\n\t\t\tCurveData[CDAccess(8,curPlayer*5)] = 1;\n\n\t\t\tCurveData[CDAccess(9,curPlayer*5)] = PlayerData[PDAccess(0,curPlayer)];\n\t\t\tCurveData[CDAccess(10,curPlayer*5)] = PlayerData[PDAccess(1,curPlayer)];\n\t\t\tCurveData[CDAccess(11,curPlayer*5)] = -1;\n\n\t\t\tCurveData[CDAccess(12,curPlayer*5)] = 16;\n\t\t\t\n\t\t\tGlobalVariables[2] = (GlobalVariables[2]+1)%NBPLAYER;\n\t\t\tGlobalVariables[0] = 2;\n\t\t}\n}\n\nfn unblock() {\n\t\tvar isActive = false;\n\t\tfor (var i : i32 = 0; i < NBCURVE; i++){\n\t\t\t\tif (CurveData[CDAccess(8,i)] == 2) { isActive = true; }\n\t\t}\n\t\tfor (var i : i32 = 0; i < NBPLAYER; i++) {\n\t\t\t\tif (!isActive){\n\t\t\t\t\t\tPlayerData[PDAccess(4,i)] = 0;\n\t\t\t\t}\n\t\t\t\telse { PlayerData[PDAccess(4,i)] = 1;}\n\t\t}\n}\n\nfn inputCannon(gid : vec3<u32>) {\n\t\tlet curPlayer = GlobalVariables[2];\n\n\t\tif (PlayerData[PDAccess(4,curPlayer )] == 0){\n\t\t\t\tif (gid.x == 0 && gid.y == 0){\n\t\t\t\t\t\tif (key == 0x62){\n\t\t\t\t\t\t\t\tif (PlayerData[PDAccess(5,curPlayer)] == 0) { PlayerData[PDAccess(5,curPlayer)] = 360; }\n\t\t\t\t\t\t\t\tPlayerData[PDAccess(5,curPlayer)] -= 1;\n\t\t\t\t\t\t}\n\t\t\t\t\n\t\t\t\t\t\tif (key == 0x68){ \n\t\t\t\t\t\t\t\tPlayerData[PDAccess(5,curPlayer)] = (PlayerData[PDAccess(5,curPlayer)]+1)%360;\n\t\t\t\t\t\t}\n\t\t\t\t\n\t\t\t\t\t\tif (key == 0x61 && PlayerData[PDAccess(6,curPlayer)] > 0) { PlayerData[PDAccess(6,curPlayer)] -= 1; }\n\t\t\t\t\n\t\t\t\t\t\tif (key == 0x67 && PlayerData[PDAccess(6,curPlayer)] < 100) { PlayerData[PDAccess(6,curPlayer)] += 1; }\n\n\t\t\t\t\t\tif (key == 0x60){\n\t\t\t\t\t\t\t\tif (GlobalVariables[3] == 0) {\n\t\t\t\t\t\t\t\t\t\tGlobalVariables[3] = 10;\n\n\t\t\t\t\t\t\t\t\t\tlet x = PlayerData[PDAccess(0,curPlayer)];\n\t\t\t\t\t\t\t\t\t\tlet y = PlayerData[PDAccess(1,curPlayer)];\n\t\t\t\t\t\t\t\t\t\tlet angle = PlayerData[PDAccess(5,curPlayer)];\n\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\tfor (var i : i32 = 0; i < NBPLAYER; i++) { PlayerData[PDAccess(4,i)] = 1; }\n\n\t\t\t\t\t\t\t\t\t\tCurveData[CDAccess(0,curPlayer*5)] = x+cos(radians(angle))*8;\n\t\t\t\t\t\t\t\t\t\tCurveData[CDAccess(1,curPlayer*5)] = y+sin(radians(angle))*8;\n\t\t\t\t\t\t\t\t\t\tCurveData[CDAccess(2,curPlayer*5)] = radians(angle);\n\t\t\t\t\t\t\t\t\t\tCurveData[CDAccess(3,curPlayer*5)] = PlayerData[PDAccess(6,curPlayer)];\n\n\t\t\t\t\t\t\t\t\t\tCurveData[CDAccess(4,curPlayer*5)] = PlayerData[PDAccess(7,curPlayer)];\n\t\t\t\t\t\t\t\t\t\tCurveData[CDAccess(5,curPlayer*5)] = PlayerData[PDAccess(8,curPlayer)];\n\t\t\t\t\t\t\t\t\t\tCurveData[CDAccess(6,curPlayer*5)] = PlayerData[PDAccess(9,curPlayer)];\n\t\t\n\t\t\t\t\t\t\t\t\t\tCurveData[CDAccess(7,curPlayer*5)] = f32(step);\n\t\t\t\t\t\t\t\t\t\tCurveData[CDAccess(8,curPlayer*5)] = 1;\n\n\t\t\t\t\t\t\t\t\t\tCurveData[CDAccess(9,curPlayer*5)] = -1;\n\t\t\t\t\t\t\t\t\t\tCurveData[CDAccess(10,curPlayer*5)] = -1;\n\t\t\t\t\t\t\t\t\t\tCurveData[CDAccess(11,curPlayer*5)] = -1;\n\n\t\t\t\t\t\t\t\t\t\tCurveData[CDAccess(12,curPlayer*5)] = 8;\n\n\t\t\t\t\t\t\t\t\t\tGlobalVariables[4] = TIMERTIME*20;\n\t\t\t\t\t\t\t\t\t\tGlobalVariables[2] = (GlobalVariables[2]+1)%NBPLAYER;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t}\n\t\t}\n}\n\nfn inputMov(gid : vec3<u32>) {\n\t\tlet curPlayer = GlobalVariables[2];\n\n\t\tlet x = i32(PlayerData[PDAccess(0,curPlayer)]);\n\t\tlet y = i32(PlayerData[PDAccess(1,curPlayer)]);\n\n\t\tlet yTarg = i32(PlayerData[PDAccess(3,curPlayer)]);\n\t\tlet xTarg = i32(PlayerData[PDAccess(2,curPlayer)]);\n\n\t\tif (PlayerData[PDAccess(4,curPlayer)] == 0){\n\t\t\t\tif (gid.x == 0 && gid.y == 0){\n\t\t\t\t\t\tif (key == 0x66 && x < (SIZEX-1) ){\n\t\t\t\t\t\t\t\tif (yTarg - y > 1 && xTarg - x > 0){\n\t\t\t\t\t\t\t\t\t\tPlayerData[PDAccess(1,curPlayer)] += 1;\n\t\t\t\t\t\t\t\t}else{\n\t\t\t\t\t\t\t\t\t\tPlayerData[PDAccess(0,curPlayer)] += 1;\n\t\t\t\t\t\t\t\t\t\tPlayerData[PDAccess(2,curPlayer)] = PlayerData[PDAccess(0,curPlayer )]+1;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\n\t\t\t\t\t\tif (key == 0x64 && x > 0){ \n\t\t\t\t\t\t\t\tif (yTarg - y > 1 && xTarg - x < 0){\n\t\t\t\t\t\t\t\t\t\tPlayerData[PDAccess(1,curPlayer)] += 1;\n\t\t\t\t\t\t\t\t}else{\n\t\t\t\t\t\t\t\t\t\tPlayerData[PDAccess(0,curPlayer)] -= 1;\n\t\t\t\t\t\t\t\t\t\tPlayerData[PDAccess(2,curPlayer)] = PlayerData[PDAccess(0,curPlayer)]-1;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t}\n\t\t}\n}\n\nfn playerPhysic(){\n\t\tfor (var i : i32 = 0; i < NBPLAYER; i++) {\n\t\t\t\tlet x = i32(PlayerData[PDAccess(0,i)]);\n\t\t\t\tlet y = i32(PlayerData[PDAccess(1,i)]);\n\n\t\t\t\tlet yTarg = i32(PlayerData[PDAccess(3,i)]);\n\t\t\t\tif (yTarg - y < 1){\n\t\t\t\t\t\tif (TerrainMatrix[TMAccess(x,y-1)] == 0 && y>0){ PlayerData[PDAccess(1,i)] -= 1; }\n\t\t\t\t\t\tif (TerrainMatrix[TMAccess(x,y)] != 0){ PlayerData[PDAccess(1,i)] += 1; }\n\t\t\t\t}\n\t\t}\n}\n\nfn targerPhysic(){\n\t\tfor (var i : i32 = 0; i < NBPLAYER; i++) {\n\t\t\t\tlet xTarg = i32(PlayerData[PDAccess(2,i)]);\n\t\t\t\tlet yTarg = i32(PlayerData[PDAccess(3,i)]);\n\n\t\t\t\tif (TerrainMatrix[TMAccess(xTarg,yTarg-1)] == 0 && yTarg>0){ PlayerData[PDAccess(3,i)] -= 1; }\n\t\t\t\tif (TerrainMatrix[TMAccess(xTarg,yTarg)] != 0){ PlayerData[PDAccess(3,i)] += 1; }\n\t\t}\n}",
      "bufferIds": [
