  "functions": [
    {
      "id": "6410ae56-c9f1-4117-b3aa-c376ffc0479b",
      "name": "Bibliothèque 1",
      "code": "fn crossProduct(x1 : i32, x2 : i32, x3 : i32, y1 : i32, y2 : i32, y3 : i32) -> i32 {\n\t\tvar v1 : vec2<i32>;\n\t\tv1[0] = x1 - x2;\n\t\tv1[1] = y1 - y2;\n\t\tvar v2 : vec2<i32>;\n\t\tv2[0] = x2 - x3;\n\t\tv2[1] = y2 - y3;\n\n\t\treturn  (v1[0]*v2[1]) - (v1[1]*v2[0]);\n}\n\nfn CDAccess(x : i32, y : i32) -> i32 {\n\t\treturn y*NBPARAMCURVE + x;\n}\n\nfn TDAccess(x : i32, y : i32) -> i32 {\n\t\treturn y*2 + x;\n}\n\nfn TMAccess(x : i32, y : i32) -> i32 {\n\t\treturn y*SIZEX + x;\n}\n\nfn CMAccess(x : i32, y : i32) -> i32 {\n\t\treturn y*SIZEX + x;\n}\n\nfn PDAccess(x : i32, y : i32) -> i32 {\n\t\treturn y*NBPARAMPLAYER + x;\n}\n\nfn PDMAccess(x : i32, y : i32) -> i32 {\n\t\treturn y*2 + x;\n}\n\nfn alea(x: u32, y: u32, step: u32) -> u32 {\n        var h: u32 = x;\n        h = h * 374761393u + y * 668265263u + step * 362437u;\n        h = (h ^(h >> 13u)) * 1274126177u;\n        h = h ^(h >> 16u);\n        return h;\n}"
    }
  ],
  "parameters": [
    {
      "id": "d1d79071-d1e5-4fe0-b892-8bd41fcc5417",
      "name": "GAMETYPE",
